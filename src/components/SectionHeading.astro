---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** Ancho máximo del bloque. En columnas anchas conviene soltarlo. */
  ancho?: string;
}
const { eyebrow, title, subtitle, align = 'left', ancho = 'max-w-2xl' } = Astro.props;
---

<div
  class:list={[
    'reveal',
    ancho,
    align === 'center' && 'mx-auto text-center',
  ]}
>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl md:text-[2.7rem] md:leading-[1.08]">
    {title}
  </h2>
  {subtitle && <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-soft)] sm:text-lg">{subtitle}</p>}
</div>
