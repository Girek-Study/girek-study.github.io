---
import SelectorIdioma from './SelectorIdioma.astro';
import { idiomaDe, textos, PAREJAS } from '../i18n';

const idioma = idiomaDe(Astro.url.pathname);
const t = textos(idioma);

/* Los destinos salen del mapa de parejas de `src/i18n`, que es el mismo que
 * usan el selector y los hreflang. Si mañana cambia una ruta, cambia en un
 * sitio y no en tres. */
const ruta = (es: string) => PAREJAS.find((p) => p.es === es)![idioma];

const links = [
  { href: ruta('/'), label: t.nav.inicio },
  { href: ruta('/trayectoria'), label: t.nav.trayectoria },
  { href: ruta('/girek-study'), label: t.nav.girekStudy },
  { href: ruta('/notas'), label: t.nav.notas },
  { href: ruta('/portafolio'), label: t.nav.portafolio },
];

// El botón de la barra será el acceso a la zona de alumnos. Hasta que exista
// el flujo de autenticación se queda oculto: un botón que no lleva a ninguna
// parte cuesta más confianza de la que aporta.
const MOSTRAR_ACCESO = false;

const path = Astro.url.pathname;

/* Antes bastaba `path.startsWith(href)`. Con dos idiomas ya no: la portada en
 * inglés es `/en/`, y `startsWith` la daría por activa en todas las páginas
 * que cuelgan de ella. Las raíces se comparan enteras y el resto por prefijo,
 * que es lo que mantiene «Notas» marcado dentro de una nota. */
const normal = (s: string) => (s.length > 1 && s.endsWith('/') ? s.slice(0, -1) : s);
const isActive = (href: string) => {
  const h = normal(href);
  const p = normal(path);
  if (h === '' || h === '/') return p === '' || p === '/';
  return p === h || p.startsWith(`${h}/`);
};
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 md:px-8">
    <a href={ruta('/')} class="group flex items-center gap-2.5" aria-label={t.nav.irAInicio}>
      <span class="grid h-11 w-11 place-items-center transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-110">
        <img src="/brand/girek-fox-head.png" alt="" width="44" height="44" class="h-full w-full object-contain" />
      </span>
      <span class="font-display text-xl leading-none tracking-tight">
        Girek <span class="text-[var(--color-fox-deep)]">Study</span>
      </span>
    </a>

    <!-- Desktop -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                'link-underline relative rounded-lg px-3.5 py-2 text-sm font-medium transition-colors',
                isActive(l.href)
                  ? 'text-[var(--color-fox-deep)]'
                  : 'text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <SelectorIdioma />
      </li>
      {
        MOSTRAR_ACCESO && (
          <li class="ml-2">
            <a href="/acceso" class="btn btn-primary !py-2.5 !px-4 text-sm">
              Iniciar sesión
            </a>
          </li>
        )
      }
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      class="grid h-10 w-10 place-items-center rounded-lg border border-[var(--color-line-strong)] text-[var(--color-ink)] md:hidden"
      aria-label={t.nav.abrirMenu}
      aria-expanded="false"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile panel -->
  <div
    id="nav-mobile"
    class="grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-300 md:hidden"
  >
    <div class="min-h-0">
      <ul class="mx-4 mb-4 space-y-1 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)]/95 p-3 shadow-[var(--shadow-soft)] backdrop-blur-xl">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'block rounded-xl px-4 py-3 text-base font-medium transition-colors',
                  isActive(l.href)
                    ? 'bg-[var(--color-fox-tint)] text-[var(--color-fox-deep)]'
                    : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-cream-2)] hover:text-[var(--color-ink)]',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="px-1 pt-2">
          <SelectorIdioma variante="ancho" />
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const cls = ['border-b', 'border-[var(--color-line)]', 'bg-[var(--color-cream)]/85', 'backdrop-blur-xl'];
  const onScroll = () => {
    if (window.scrollY > 12) nav?.classList.add(...cls);
    else nav?.classList.remove(...cls);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('grid-rows-[1fr]');
    panel?.classList.toggle('grid-rows-[0fr]', !open);
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
