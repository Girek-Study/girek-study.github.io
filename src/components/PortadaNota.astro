---
/**
 * La pieza que ilustra la cabecera de una nota.
 *
 * No son imágenes de archivo: cada una dibuja el problema del que trata su
 * nota, con el mismo dato que aparece dentro del texto. Una foto de gente
 * señalando una pantalla no dice nada; un contrato que cambia de tipo, sí.
 *
 * Van en HTML y CSS, no en PNG: pesan nada, escalan sin pixelarse y el texto
 * que llevan dentro se puede copiar.
 */
interface Props {
  tipo:
    | 'contrato'
    | 'capas'
    | 'pipeline'
    | 'criterio'
    | 'espera'
    | 'mcp'
    | 'datos'
    | 'carga'
    | 'rojo'
    | 'metricas'
    | 'ruta'
    | 'traducir'
    | 'acceso'
    | 'revision'
    | 'vitals';
}

const { tipo } = Astro.props;
---

<div class="portada-nota" aria-hidden="true">
  <span class="trama-nota"></span>
  <span class="halo-nota"></span>

  <div class="marco-nota">
    <span class="semaforo"><i></i><i></i><i></i></span>

    {
      tipo === 'contrato' && (
        <div class="pieza-contrato">
          {/* El mismo importe antes y después: el tipo cambió y la pantalla no
              se entera. Es el ejemplo que abre la nota. */}
          <p class="fila-formato">
            <span class="sello-formato es-antes">XML</span>
            <code>&lt;monto&gt;1500.00&lt;/monto&gt;</code>
          </p>

          <p class="flecha-formato">↓</p>

          <p class="fila-formato">
            <span class="sello-formato es-despues">JSON</span>
            <code>"monto": <b>1500</b></code>
          </p>

          <p class="aviso-formato">
            <span>!</span> el tipo cambió y la interfaz lo pinta igual
          </p>
        </div>
      )
    }

    {
      tipo === 'capas' && (
        <div class="pieza-capas">
          {/* Las cuatro responsabilidades que el patrón separa, de arriba
              abajo. La nota discute cuándo esa separación paga. */}
          {[
            { rol: 'Actor', valor: 'ana' },
            { rol: 'Tarea', valor: 'IniciarSesion' },
            { rol: 'Interacción', valor: 'Escribir · Pulsar' },
            { rol: 'Localizador', valor: 'CampoUsuario' },
          ].map((c) => (
            <p class="fila-capa">
              <span class="rol-capa">{c.rol}</span>
              <code>{c.valor}</code>
            </p>
          ))}
        </div>
      )
    }

    {
      tipo === 'pipeline' && (
        <div class="pieza-pipeline-nota">
          {/* Dos ejecuciones con el mismo código: la de arriba falla por algo
              que no es tuyo. De eso trata la nota. */}
          <p class="corrida es-rota">
            <span class="marca-corrida">✕</span>
            <code>suite · el sitio de demo no responde</code>
          </p>
          <p class="corrida es-rota">
            <span class="marca-corrida">✕</span>
            <code>suite · rate limit del sitio de demo</code>
          </p>
          <p class="separador-corridas">
            <span>la app de ejemplo pasa a vivir en el repositorio</span>
          </p>
          <p class="corrida es-verde">
            <span class="marca-corrida">✓</span>
            <code>suite · hermética, sin red</code>
          </p>
        </div>
      )
    }

    {
      tipo === 'criterio' && (
        <div class="pieza-contrato">
          {/* El modelo entrega diferencias; el defecto aparece cuando alguien
              las clasifica. Ese salto es el tema de la nota. */}
          <p class="fila-formato">
            <span class="sello-formato es-antes">IA</span>
            <code>3 diferencias detectadas</code>
          </p>

          <p class="flecha-formato">↓</p>

          <p class="fila-formato">
            <span class="sello-formato es-despues">TÚ</span>
            <code>1 acordada · 1 no contada · <b>1 defecto</b></code>
          </p>

          <p class="aviso-formato">
            <span>!</span> comparar es cálculo; clasificar es criterio
          </p>
        </div>
      )
    }

    {
      tipo === 'espera' && (
        <div class="pieza-espera">
          {/* Lo mismo esperado de dos formas: por reloj, que tarda siempre lo
              mismo aunque ya se haya cumplido, y por condición, que sale en
              cuanto ocurre. */}
          <p class="fila-espera es-fija">
            <span class="marca-espera">✕</span>
            <code>waitForTimeout(2000)</code>
            <span class="barra-espera"><i style="width:100%"></i></span>
            <span class="coste-espera">2.0s</span>
          </p>

          <p class="fila-espera es-viva">
            <span class="marca-espera">✓</span>
            <code>expect(total).toHaveText(...)</code>
            <span class="barra-espera"><i style="width:9%"></i></span>
            <span class="coste-espera">0.2s</span>
          </p>

          <p class="aviso-formato">
            <span>!</span> el sleep no falla cuando la app se vuelve lenta: aguanta
          </p>
        </div>
      )
    }

    {
      tipo === 'mcp' && (
        <div class="pieza-mcp">
          {/* Lo que el modelo recibe de cada forma: una imagen que hay que
              interpretar, o roles y nombres que se pueden referenciar. */}
          <p class="via-mcp es-ciega">
            <span class="sello-formato es-antes">Captura</span>
            <code>"el botón azul de abajo"</code>
          </p>

          <p class="flecha-formato">↓</p>

          <p class="via-mcp es-clara">
            <span class="sello-formato es-despues">Árbol a11y</span>
            <code>button · name=<b>"Ingresar"</b></code>
          </p>

          <p class="aviso-formato">
            <span>!</span> lo segundo es una referencia; lo primero, una interpretación
          </p>
        </div>
      )
    }

    {
      tipo === 'datos' && (
        <div class="pieza-datos">
          {/* Dos pruebas apuntando al mismo registro, y una tercera con el
              suyo. Lo que falla es la colisión, no el entorno. */}
          <p class="fila-dato es-choque">
            <span class="sello-formato es-antes">test A</span>
            <code>qa_test_01</code>
          </p>
          <p class="fila-dato es-choque">
            <span class="sello-formato es-antes">test B</span>
            <code>qa_test_01</code>
            <span class="choque">colisión</span>
          </p>

          <p class="fila-dato es-propio">
            <span class="sello-formato es-despues">test C</span>
            <code>qa_1726502841_a7f3</code>
          </p>

          <p class="aviso-formato">
            <span>!</span> el rojo no era del entorno: una llegó primero
          </p>
        </div>
      )
    }

    {
      tipo === 'carga' && (
        <div class="pieza-carga">
          {/* El promedio tranquiliza; la cola es la que espera. */}
          <p class="fila-percentil">
            <span class="rotulo-percentil">p50</span>
            <span class="barra-percentil"><i style="width:14%"></i></span>
            <span class="valor-percentil">180ms</span>
          </p>
          <p class="fila-percentil">
            <span class="rotulo-percentil">p95</span>
            <span class="barra-percentil"><i style="width:38%"></i></span>
            <span class="valor-percentil">500ms</span>
          </p>
          <p class="fila-percentil es-alarma">
            <span class="rotulo-percentil">p99</span>
            <span class="barra-percentil"><i style="width:100%"></i></span>
            <span class="valor-percentil">11s</span>
          </p>

          <p class="aviso-formato">
            <span>!</span> el umbral estaba en p95: nadie miraba la cola
          </p>
        </div>
      )
    }

    {
      tipo === 'rojo' && (
        <div class="pieza-rojo">
          {/* El historial de ejecuciones: se ve de un vistazo el día en que
              el rojo dejó de ser una excepción. */}
          <span class="tira-ejecuciones">
            {[
              'ok', 'ok', 'ok', 'ok', 'mal', 'ok', 'mal', 'mal',
              'mal', 'mal', 'mal', 'mal', 'mal', 'mal', 'mal', 'mal',
            ].map((e) => (
              <i class={e === 'mal' ? 'es-mal' : 'es-ok'} />
            ))}
          </span>

          <p class="fila-ejecucion">
            <span class="sello-formato es-antes">#218</span>
            <code>4 fallos — los mismos de ayer</code>
          </p>

          <p class="aviso-formato">
            <span>!</span> «esas siempre fallan»: el rojo ya no avisa de nada
          </p>
        </div>
      )
    }

    {
      tipo === 'metricas' && (
        <div class="pieza-metricas">
          {/* Arriba, las que se suben sin tocar el producto. Abajo, las que
              miden lo que le pasa a quien lo usa. */}
          {[
            { que: 'casos ejecutados', vale: false },
            { que: '% de cobertura', vale: false },
            { que: 'defectos escapados', vale: true },
            { que: 'minutos hasta el rojo', vale: true },
          ].map((m) => (
            <p class={`fila-metrica ${m.vale ? 'es-buena' : 'es-vacia'}`}>
              <span class="marca-metrica">{m.vale ? '✓' : '✕'}</span>
              <code>{m.que}</code>
            </p>
          ))}

          <p class="aviso-formato">
            <span>!</span> las dos primeras miden esfuerzo; las otras, resultado
          </p>
        </div>
      )
    }

    {
      tipo === 'ruta' && (
        <div class="pieza-ruta">
          {/* Las capas en el orden que importa: la herramienta es la quinta,
              no la primera. Se lee de abajo arriba, como se construye. */}
          {[
            { n: '08', que: 'Comunicar y decidir', tono: 'alta' },
            { n: '05', que: 'Automatización', tono: 'media' },
            { n: '03', que: 'Programar', tono: 'media' },
            { n: '01', que: 'Qué significa probar', tono: 'base' },
          ].map((c) => (
            <p class={`peldano es-${c.tono}`}>
              <span class="peldano-n">{c.n}</span>
              <code>{c.que}</code>
            </p>
          ))}

          <p class="aviso-formato">
            <span>!</span> saltarse la base es llegar antes y estancarse después
          </p>
        </div>
      )
    }

    {
      tipo === 'traducir' && (
        <div class="pieza-traducir">
          {/* El riesgo en palabras y su señal en código: lo mismo dicho dos
              veces, que es justo lo que hace la traducción. */}
          <p class="lado-riesgo">
            <span class="sello-formato es-antes">Riesgo</span>
            <code>entra alguien que no debería</code>
          </p>

          <p class="flecha-formato">↓</p>

          <p class="lado-senal">
            <span class="sello-formato es-despues">Señal</span>
            <code>no hay <b>cookie de sesión</b></code>
          </p>

          <p class="aviso-formato">
            <span>!</span> el mensaje en pantalla es cosmética; la cookie es el hecho
          </p>
        </div>
      )
    }

    {
      tipo === 'acceso' && (
        <div class="pieza-acceso">
          {/* Lo que cubre la máquina y lo que no. La proporción es el dato:
              ningún escáner serio promete más de un tercio. */}
          <p class="franja-acceso">
            <span class="sello-formato es-despues">axe</span>
            <span class="barra-acceso"><i style="width:33%" /></span>
            <code>~1/3</code>
          </p>

          <p class="franja-acceso es-manual">
            <span class="sello-formato es-antes">criterio</span>
            <span class="barra-acceso"><i class="es-manual" style="width:67%" /></span>
            <code>~2/3</code>
          </p>

          <p class="aviso-formato">
            <span>!</span> teclado, foco y textos que digan algo: eso no lo ve un escáner
          </p>
        </div>
      )
    }

    {
      tipo === 'revision' && (
        <div class="pieza-revision">
          {/* Lo que se aprueba sin mirar, y las tres preguntas que lo frenan. */}
          <p class="sello-lgtm">LGTM 👍</p>

          {[
            '¿qué riesgo cubre?',
            '¿está al nivel correcto?',
            '¿qué comprueba de verdad?',
          ].map((q) => (
            <p class="fila-revision">
              <span class="marca-revision">?</span>
              <code>{q}</code>
            </p>
          ))}

          <p class="aviso-formato">
            <span>!</span> el código de producción se revisa; el de las pruebas se aprueba
          </p>
        </div>
      )
    }

    {
      tipo === 'vitals' && (
        <div class="pieza-vitals">
          {/* El servidor contestó rápido; la pantalla siguió pareciendo lenta. */}
          <p class="fila-vital es-ok">
            <span class="rotulo-vital">servidor</span>
            <span class="barra-vital"><i style="width:12%" /></span>
            <span class="valor-vital">200ms</span>
          </p>

          <p class="fila-vital es-alarma">
            <span class="rotulo-vital">LCP</span>
            <span class="barra-vital"><i style="width:78%" /></span>
            <span class="valor-vital">3.4s</span>
          </p>

          <p class="aviso-formato">
            <span>!</span> entre las dos caben las fuentes, el JS y las imágenes
          </p>
        </div>
      )
    }
  </div>
</div>
