---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/site';
import { proyectos } from '../data/projects';
import { obtenerRepos, haceCuanto } from '../data/github';
import { idiomaDe, textos, elegir } from '../i18n';

/* El idioma sale de la URL, no de una propiedad: este mismo cuerpo lo
 * renderizan /portafolio y /en/portfolio, y cada uno ve su propio pathname.
 * Así no hay dos copias de la página que mantener en paralelo. */
const idioma = idiomaDe(Astro.url.pathname);
const t = textos(idioma);

/* El filtro vivía arriba del todo y filtraba una rejilla que estaba a dos
 * pantallas de distancia: se pulsaba una categoría y no pasaba nada visible.
 * Ahora va pegado a lo que filtra, y cada botón dice cuántos casos tiene. */
const categorias = [
  { clave: 'Todos', nombre: t.portafolio.todos, cuantos: proyectos.length },
  ...Array.from(new Set(proyectos.map((p) => p.categoria))).map((clave) => ({
    clave,
    nombre: t.portafolio.categorias[clave] ?? clave,
    cuantos: proyectos.filter((p) => p.categoria === clave).length,
  })),
];

const sectores = Array.from(new Set(proyectos.map((p) => p.sector)));

// Se resuelve en el build: el visitante recibe HTML, no una llamada a GitHub.
const repos = await obtenerRepos(idioma);

// Los destacados primero: es lo que un reclutador mira si solo mira tres.
const casos = [...proyectos].sort((a, b) => Number(!!b.destacado) - Number(!!a.destacado));

/* Un punto de color por lenguaje, como en GitHub. Reconocerlo de un vistazo
 * ahorra leer la etiqueta. */
const COLOR_LENGUAJE: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Java: '#b07219',
  Python: '#3572A5',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Shell: '#89e051',
  Astro: '#ff5a03',
};
---

<Layout
  title={`${t.portafolio.meta.titulo} — ${profile.nombre}`}
  description={t.portafolio.meta.descripcion}
>
  <section class="relative overflow-hidden pt-28 pb-10 md:pt-36">
    <div class="blob -z-10 right-[-4rem] top-10 h-80 w-80" style="background: var(--color-coral)"></div>
    <div class="blob -z-10 left-[-6rem] top-44 h-64 w-64" style="background: var(--color-cyan-tint); animation-delay: -7s"></div>

    <div class="mx-auto max-w-[82rem] px-5 md:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end lg:gap-16">
        <div class="reveal">
          <p class="eyebrow">{t.portafolio.rotulo}</p>
          <h1 class="mt-3.5 max-w-2xl font-display text-[2.5rem] leading-[1.04] tracking-tight sm:text-5xl md:text-[3.4rem]">
            {t.portafolio.titular}
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
            {t.portafolio.entradilla}
          </p>
        </div>

        <aside class="reveal ficha-notas card p-6 md:p-7" data-delay="120ms">
          <dl class="cifras-notas">
            <div>
              <dt>{t.portafolio.cifras.casos}</dt>
              <dd>{proyectos.length}</dd>
            </div>
            <div>
              <dt>{t.portafolio.cifras.repos}</dt>
              <dd>{repos.length}</dd>
            </div>
            <div>
              <dt>{t.portafolio.cifras.sectores}</dt>
              <dd>{sectores.length}</dd>
            </div>
          </dl>

          <p class="mt-5 text-[0.88rem] leading-relaxed text-[var(--color-ink-soft)]">
            {t.portafolio.notaApi}
          </p>

          <a href={profile.links.github} target="_blank" rel="noopener" class="btn btn-ghost mt-5 w-full justify-center text-[0.92rem]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 1.8a10.2 10.2 0 0 0-3.22 19.88c.51.1.7-.22.7-.49l-.01-1.9c-2.84.62-3.44-1.2-3.44-1.2-.46-1.18-1.13-1.5-1.13-1.5-.93-.63.07-.62.07-.62 1.03.07 1.57 1.06 1.57 1.06.91 1.57 2.4 1.12 2.99.85.09-.66.36-1.12.65-1.38-2.27-.26-4.65-1.14-4.65-5.06 0-1.12.4-2.03 1.05-2.74-.1-.26-.46-1.3.1-2.71 0 0 .86-.28 2.81 1.05a9.7 9.7 0 0 1 5.12 0c1.95-1.33 2.81-1.05 2.81-1.05.56 1.41.2 2.45.1 2.71.65.71 1.05 1.62 1.05 2.74 0 3.93-2.39 4.79-4.67 5.05.37.32.69.94.69 1.9l-.01 2.81c0 .27.19.6.71.49A10.2 10.2 0 0 0 12 1.8Z" />
            </svg>
            {t.portafolio.verCuenta}
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ CASOS DE TRABAJO ============ -->
  <section class="mx-auto max-w-[82rem] px-5 pb-16 md:px-8">
    <div class="reveal cabecera-bloque">
      <div>
        <p class="eyebrow">{t.portafolio.casosRotulo}</p>
        <h2 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">
          {t.portafolio.casosTitulo}
        </h2>
      </div>
      <p class="nota-bloque">
        {t.portafolio.casosNota}
      </p>
    </div>

    <nav class="reveal barra-temas mt-6" aria-label={t.portafolio.filtrarPorCategoria}>
      {categorias.map((c, i) => (
        <button
          type="button"
          class:list={['chip', 'chip-tema', i === 0 && 'is-activo']}
          data-cat={c.clave}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {c.nombre} <span class="cuenta-tema">{c.cuantos}</span>
        </button>
      ))}
    </nav>

    <div id="grid-proyectos" class="rejilla-casos">
      {
        casos.map((p, i) => (
          <article
            class="proyecto reveal card card-hover ficha-caso"
            data-cat={p.categoria}
            data-delay={`${(i % 3) * 70}ms`}
          >
            <div class="cabeza-caso">
              <span class="sector-caso">{t.portafolio.sectores[p.sector] ?? p.sector}</span>
              {p.destacado && <span class="sello-destacado">{t.portafolio.destacado}</span>}
            </div>

            <h3 class="titulo-caso">{elegir(p.titulo, idioma)}</h3>
            <p class="resumen-caso">{elegir(p.resumen, idioma)}</p>

            {p.metrica && (
              <div class="metrica-caso">
                <span class="valor-metrica">{p.metrica.valor}</span>
                <span class="etiqueta-metrica">{elegir(p.metrica.etiqueta, idioma)}</span>
              </div>
            )}

            <div class="pie-caso">
              <span class="temas-nota">
                {p.tags.map((etiqueta) => (
                  <span class="tema-claro">{t.portafolio.etiquetas[etiqueta] ?? etiqueta}</span>
                ))}
              </span>

              {(p.repo || p.demo) && (
                <span class="enlaces-caso">
                  {p.repo && (
                    <a href={p.repo} target="_blank" rel="noopener" class="link-underline text-sm font-semibold text-[var(--color-fox-dark)]">
                      {t.portafolio.codigo} →
                    </a>
                  )}
                  {p.demo && (
                    <a href={p.demo} target="_blank" rel="noopener" class="link-underline text-sm font-semibold text-[var(--color-ink)]">
                      {t.portafolio.demo} →
                    </a>
                  )}
                </span>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div id="vacio" class="estado-vacio" hidden>
      <img src="/brand/girek-fox-head.png" alt="" width="64" height="64" />
      <p>{t.portafolio.sinCasos}</p>
    </div>
  </section>

  <!-- ============ REPOSITORIOS ============ -->
  <section class="mx-auto max-w-[82rem] px-5 pb-24 md:px-8">
    <div class="reveal cabecera-bloque">
      <div>
        <p class="eyebrow">{t.portafolio.reposRotulo}</p>
        <h2 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">{t.portafolio.reposTitulo}</h2>
      </div>
      <p class="nota-bloque">
        {t.portafolio.reposNota}
      </p>
    </div>

    {
      repos.length > 0 ? (
        /* Las columnas siguen a la cantidad: con un solo repositorio, una
           rejilla de tres deja dos huecos que parecen un error de carga. */
        <div
          class:list={['rejilla-repos', repos.length === 1 && 'es-sola']}
          style={`--columnas:${Math.min(repos.length, 3)}`}
        >
          {repos.map((r, i) => (
            /* La tarjeta entera lleva al repositorio, pero los que tienen
               documentación de calidad necesitan un segundo enlace, y un <a>
               dentro de otro <a> no es HTML válido. De ahí el patrón de enlace
               que tapa la tarjeta: el <article> no es interactivo, el enlace
               principal se estira por encima de todo, y el de la documentación
               se levanta un nivel más para quedar por delante. */
            <article
              class="reveal card card-hover ficha-repo group"
              data-delay={`${(i % 3) * 70}ms`}
            >
              <div class="cabeza-repo">
                <span class="icono-repo" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5.5 4.6A1.6 1.6 0 0 1 7.1 3h11.4v14.4H7.1a1.6 1.6 0 0 0-1.6 1.6V4.6Z" />
                    <path d="M5.5 19a1.6 1.6 0 0 0 1.6 1.6h11.4" />
                  </svg>
                </span>
                {r.estrellas > 0 && (
                  <span class="estrellas-repo">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="m12 3.6 2.6 5.3 5.9.86-4.25 4.14 1 5.86L12 17l-5.25 2.76 1-5.86L3.5 9.76l5.9-.86L12 3.6Z" />
                    </svg>
                    {r.estrellas}
                  </span>
                )}
              </div>

              <h3 class="nombre-repo">{r.nombre}</h3>
              <p class="resumen-nota">{r.descripcion}</p>

              <span class="temas-nota">
                {r.temas.slice(0, 4).map((tema) => (
                  <span class="tema-claro">{tema}</span>
                ))}
              </span>

              <span class="pie-repo">
                <span class="lenguaje-repo">
                  {r.lenguaje && (
                    <span
                      class="punto-lenguaje"
                      style={`background:${COLOR_LENGUAJE[r.lenguaje] ?? 'var(--color-line-strong)'}`}
                      aria-hidden="true"
                    />
                  )}
                  {r.lenguaje ?? t.portafolio.repositorio}
                  <span class="separador-repo" aria-hidden="true">·</span>
                  {haceCuanto(r.actualizado, idioma)}
                </span>
                <span class="ver-codigo">
                  {t.portafolio.verCodigo}
                  <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
                  </svg>
                </span>
              </span>

              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                class="enlace-tapa"
                aria-label={t.portafolio.verCodigoDe(r.nombre)}
              />

              {r.docs && (
                <a href={r.docs} target="_blank" rel="noopener" class="enlace-docs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H15l5 5v9.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13Z" />
                    <path d="M14.5 4v5.5H20M8 13h8M8 16.5h5" />
                  </svg>
                  <span>
                    <b>{t.portafolio.documentacion}</b>
                    <small>{r.docsResumen}</small>
                  </span>
                </a>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-8 font-mono text-sm text-[var(--color-faint)]">
          {t.portafolio.sinGitHub}{' '}
          <a href={profile.links.github} target="_blank" rel="noopener" class="link-underline">
            {t.portafolio.verDirectamente}
          </a>
        </p>
      )
    }
  </section>

  <script>
    /* Filtro de casos. Mismo mecanismo que el de las notas: se esconde lo que
     * no coincide, no se reordena ni se vuelve a pintar la rejilla. */
    const botones = document.querySelectorAll<HTMLButtonElement>('.chip-tema');
    const fichas = document.querySelectorAll<HTMLElement>('.proyecto');
    const vacio = document.getElementById('vacio');

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const categoria = boton.dataset.cat;

        botones.forEach((otro) => {
          const activo = otro === boton;
          otro.classList.toggle('is-activo', activo);
          otro.setAttribute('aria-pressed', String(activo));
        });

        let visibles = 0;
        fichas.forEach((ficha) => {
          const pasa = categoria === 'Todos' || ficha.dataset.cat === categoria;
          ficha.hidden = !pasa;
          if (pasa) visibles++;
        });

        if (vacio) vacio.hidden = visibles > 0;
      });
    });
  </script>
</Layout>
