      {/* Antes eran tres botones apilados a un lado, todos del mismo peso y sin
          decir a dónde llevaban. Ahora cada destino es una tarjeta con su icono
          y una línea: se elige sabiendo qué hay detrás. */}
      <div class="bloque-cierre reveal relative overflow-hidden rounded-[28px] p-9 text-white md:p-12">
        <div class="trama-cierre pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="brillo-cierre pointer-events-none absolute -right-32 -top-40 h-96 w-96 rounded-full" aria-hidden="true"></div>

        <div class="relative">
          <div class="grid items-end gap-5 lg:grid-cols-[1fr_minmax(0,22rem)] lg:gap-12">
