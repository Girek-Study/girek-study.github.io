          </div>
        </div>
      </header>

      <div class="max-h-[60vh] overflow-y-auto px-7 py-6 md:px-8">
        <div id="dc-via" class="mb-6"></div>
        <div id="dc-logros"></div>
      </div>

      <footer class="flex items-center justify-between gap-4 border-t border-[var(--color-line)] bg-[var(--color-cream)] px-7 py-4 md:px-8">
        <span id="dc-dominio" class="truncate font-mono text-xs text-[var(--color-faint)]"></span>
        <a
          id="dc-web"
          href="#"
          target="_blank"
          rel="noopener"
          class="btn btn-primary shrink-0 !px-5 !py-2.5 text-sm"
        >
          Visitar el sitio
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </footer>
    </dialog>
  </section>

  <!-- ============ IA APLICADA ============ -->
  <section id="ia" class="sector">
    {/* Un solo bloque oscuro, y el carrusel va dentro. Separados, el panel se
        veía premium y debajo quedaba una fila de cajas blancas corrientes: las
        tarjetas son la prueba de lo que afirma el titular, así que pertenecen
        a la misma pieza. Además los logotipos de los modelos están hechos para
        fondos oscuros, que es donde se ven como se deben ver. */}
    <div class="bloque-ia relative overflow-hidden rounded-[32px] px-7 pt-7 pb-6 md:px-10">
      <div class="brillo-ia pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full"></div>

      <div class="relative">
        <p class="reveal font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-amber)]">
          IA aplicada
        </p>
        <h2
          class="reveal mt-3 max-w-3xl font-display text-[2rem] leading-[1.08] tracking-tight text-white md:text-[2.5rem]"
          data-delay="60ms"
        >
          Dónde entra la IA en mi trabajo
        </h2>
        <p class="reveal texto-justo mt-3 max-w-3xl leading-relaxed text-white/65" data-delay="100ms">
          Tres capas distintas, y conviene no mezclarlas: construir herramientas propias, meter
          modelos dentro del ciclo de pruebas, y probar productos que llevan IA por dentro.
        </p>

        <div class="reveal mt-5 flex flex-wrap items-start gap-x-10 gap-y-5" data-delay="140ms">
          <dl class="flex flex-wrap gap-x-8 gap-y-5">
            {
              [
                { valor: '3', titulo: 'capas donde la aplico, sin mezclarlas' },
                { valor: String(iaEnElCiclo.length), titulo: 'usos dentro del ciclo de pruebas' },
                { valor: '100%', titulo: 'bajo revisión humana, sin excepciones' },
              ].map((c) => (
                <div class="w-[13rem] border-l-2 border-[var(--color-amber)]/60 pl-4">
                  <dt class="font-display text-[2rem] leading-none text-[var(--color-amber)]">{c.valor}</dt>
                  <dd class="mt-1.5 text-[0.8rem] leading-snug text-white/60">{c.titulo}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div
          class="reveal mt-5 flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-white/10 pt-3.5"
          data-delay="180ms"
        >
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-white/40">Modelos</span>
          {
            modelos.map((m) => (
              <span class="flex items-center gap-2 text-white/75">
                <span class="herramienta herramienta-sm" aria-hidden="true" set:html={m.svg} />
                <span class="text-[0.82rem]">{m.nombre}</span>
              </span>
            ))
          }
        </div>
      </div>

      <div id="agentes" class="relative mt-6 border-t border-white/10 pt-4">
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
          <h3 class="font-display text-xl tracking-tight text-white md:text-[1.4rem]">
            Agentes y herramientas que construí
          </h3>
          <p class="font-mono text-[0.68rem] text-white/35">
            software propio, en producción
            <span class="hidden md:inline"> · pasa el cursor para detener</span>
            <span class="md:hidden"> · toca una tarjeta para ver su modelo</span>
          </p>
        </div>

        {/* La cinta sangra hasta los bordes del panel y se desvanece contra él;
            recortada por dentro se leería como una caja más. */}
        <div class="marquee-track marquee-difuminado -mx-7 mt-3 overflow-hidden md:-mx-10">
          <ol class="marquee marquee-agentes gap-3.5 pl-7 md:pl-10">
            {
              [...agentesIA, ...agentesIA].map((a, i) => (
                <li class="flex shrink-0">
                <button
                  type="button"
                  data-agente={a.titulo}
                  aria-haspopup="dialog"
                  class="tarjeta-agente flex w-[17.5rem] flex-col p-4 text-left md:w-[19rem]"
                >
                  <div class="flex w-full items-start justify-between gap-3">
                    <span class="icono-agente" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={ICONOS_AGENTE[a.icono ?? 'panel']} />
                      </svg>
                    </span>
                    <span class="font-display text-[1.6rem] leading-none text-white/12">
                      {String((i % agentesIA.length) + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <p class="mt-3 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-[var(--color-amber)]/70">
                    {a.contexto}
                  </p>
                  <h4 class="mt-1.5 font-display text-[1.02rem] leading-snug tracking-tight text-white">
                    {a.titulo}
                  </h4>
                  <p class="texto-justo mt-2 text-[0.82rem] leading-relaxed text-white/55">{a.detalle}</p>

                  <span class="mt-auto flex items-center gap-1.5 pt-3 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-white/35 transition-colors">
                    Ver el modelo
                    <svg
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </button>
              </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    {/* Modelo conceptual del agente. Uno solo que se rellena al pulsar, igual
        que el de clientes: ocho diálogos en el HTML pesarían sin que nadie los
        abra. Va en oscuro porque sale del bloque oscuro. */}
    <dialog
      id="dialogo-agente"
      tabindex="-1"
      class="dialogo-agente m-auto w-[min(52rem,94vw)] overflow-hidden rounded-[28px] p-0 backdrop:bg-[rgba(6,10,20,0.62)] backdrop:backdrop-blur-sm"
    >
      <header class="relative border-b border-white/10 px-7 py-6 md:px-8">
        <button
          type="button"
          id="da-cerrar"
          aria-label="Cerrar"
          class="absolute right-5 top-5 grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/60 transition-colors hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-start gap-4 pr-12">
          <span id="da-icono" class="icono-agente !h-12 !w-12 !rounded-[14px]" aria-hidden="true"></span>
          <div class="min-w-0">
            <p id="da-contexto" class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--color-amber)]/80"></p>
            <h3 id="da-titulo" class="mt-1.5 font-display text-[1.55rem] leading-tight tracking-tight text-white"></h3>
          </div>
        </div>
      </header>

      <div class="max-h-[66vh] overflow-y-auto px-7 py-6 md:px-8">
        <p id="da-detalle" class="texto-justo text-[0.92rem] leading-relaxed text-white/65"></p>

        <p class="mt-7 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-white/35">
          Cómo funciona
        </p>

        {/* Diagrama de flujo. Los conectores se dibujan en SVG desde el guion,
            porque su trazado depende de cuántas entradas y salidas tenga cada
            agente: con dos o con tres el abanico no es el mismo. */}
        <div class="diagrama mt-4">
          <div class="columna-nodos" id="da-entrada" data-lado="entrada"></div>
          <div class="conector" id="da-con-1"></div>

          <div class="nucleo">
            <div class="flex items-center gap-2.5">
              <span id="da-nucleo-icono" class="nucleo-icono" aria-hidden="true"></span>
              <p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--color-amber)]">
                El agente
              </p>
            </div>
            <ol id="da-proceso" class="pasos"></ol>
          </div>

          <div class="conector" id="da-con-2"></div>
          <div class="columna-nodos" id="da-salida" data-lado="salida"></div>
        </div>

        <p class="mt-7 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-white/35">
          Dónde actúa en el ciclo
        </p>

        {/* Mapa del ciclo: las mismas seis fases de la sección de abajo, con
            las que toca este agente encendidas. Es lo que sitúa la herramienta
            dentro del proceso en vez de dejarla suelta. */}
        <ol id="da-mapa" class="mapa-ciclo mt-3.5"></ol>
      </div>

      <footer class="flex items-center justify-between gap-4 border-t border-white/10 px-7 py-4 md:px-8">
        <span id="da-indice" class="font-mono text-xs text-white/30"></span>
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-white/30">
          Bajo revisión humana
        </span>
      </footer>
    </dialog>
  </section>

  <section id="ciclo" class="sector">
    {/* Antes era una parrilla de tarjetas de altura desigual, que no decía nada
        sobre el ciclo — justo lo que titula la sección. Ahora son las seis
        fases en su orden real, colgadas de un riel numerado. La séptima no es
        una fase y va aparte, que es lo que de verdad es. */}
    <h3 class="reveal font-display text-3xl tracking-tight md:text-[2.2rem]">
      IA dentro del ciclo de pruebas
    </h3>

    {/* La regla ocupa el ancho entero, como el panel de abajo: encogida a media
        columna dejaba medio sector vacío. Y va con su icono porque no es una
        entradilla, es la condición bajo la que se aplica todo lo de abajo. */}
    <div class="reveal banda-regla mt-3.5 flex items-start gap-4 rounded-2xl py-3.5 pl-5 pr-6" data-delay="60ms">
      <span class="icono-regla" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 4.5 6v5.5c0 4.4 3.2 8.2 7.5 9.5 4.3-1.3 7.5-5.1 7.5-9.5V6L12 3Z M9 12l2 2 4-4" />
        </svg>
      </span>
      <p class="texto-justo text-[0.9rem] leading-relaxed text-[var(--color-ink-soft)]">
        Aplicado en proyectos de cliente, con una regla fija: ninguna salida del modelo se
        convierte en un caso ejecutable ni en un defecto reportado sin revisión humana.
      </p>
    </div>

    {/* Sobre panel sólido: encima de la cuadrícula del fondo, seis bloques de
        texto seguidos se leían lavados. Las divisiones son huecos de 1px que
        dejan ver el color del panel, así que cuadran solas en cualquier
        reacomodo y no hay bordes que se dupliquen. */}
    <div class="panel-fases mt-4 overflow-hidden rounded-[26px]">
      <ol class="grid gap-px bg-[var(--color-line-strong)] sm:grid-cols-2 xl:grid-cols-3">
        {
          ciclo.map((a, i) => (
            <li
              class="reveal fase flex flex-col bg-[var(--color-surface)] px-5 py-3"
              data-delay={`${(i % 3) * 70}ms`}
            >
              {/* El sector baja al pie: arriba partía el rótulo en dos líneas y
                  descuadraba los titulares, y abajo ocupa el hueco que dejaban
                  las fases de texto corto. */}
              <div class="flex items-center gap-3">
                <span class="ficha-fase">{String(i + 1).padStart(2, '0')}</span>
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">
                  {a.etapa}
                </p>
              </div>

              <h4 class="mt-2.5 font-display text-[1.06rem] leading-snug tracking-tight">{a.titulo}</h4>
              <p class="texto-justo mt-2 text-[0.82rem] leading-[1.5] text-[var(--color-ink-soft)]">
                {a.detalle}
              </p>

              <p class="mt-auto pt-3 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-[var(--color-faint)]">
                {a.contexto}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    {/* La séptima no ocurre dentro del ciclo: es probar un producto que lleva
        IA. Meterla en la misma fila la haría pasar por una fase más. */}
    <div class="reveal aparte mt-3 flex flex-col gap-4 rounded-3xl p-5 md:flex-row md:items-center md:gap-8 md:p-6">
      <div class="flex items-center gap-4 md:w-64 md:shrink-0">
        <span class="icono-aparte" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 7.5h14v9H3z M17 11l4-2.5v7L17 13 M7 3.5h1 M11 3.5h1" />
          </svg>
        </span>
        <div>
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--color-fox-dark)]">
            {aparte.etapa}
          </p>
          <h4 class="mt-1 font-display text-[1.2rem] leading-snug tracking-tight">{aparte.titulo}</h4>
        </div>
      </div>
      <p class="texto-justo text-[0.88rem] leading-relaxed text-[var(--color-ink-soft)]">
        {aparte.detalle}
      </p>
    </div>
  </section>

  <!-- ============ COMPETENCIAS ============ -->
  <section id="competencias" class="sector">
    <SectionHeading
      eyebrow="Qué sé hacer"
      title="Competencias"
      subtitle="Lo que defiendo en una entrevista técnica, agrupado por para qué sirve."
    />

    {/* Mismo tratamiento que el ciclo: panel opaco y divisiones de 1px. Antes
        eran ocho tarjetas sueltas de altura desigual y la segunda fila se
        cortaba; ahora la rejilla cuadra y cada bloque se rotula con su icono. */}
    <div class="panel-fases mt-6 overflow-hidden rounded-[26px]">
      <div class="grid gap-px bg-[var(--color-line-strong)] sm:grid-cols-2 xl:grid-cols-4">
        {
          competencias.map((c, i) => (
            <article
              class="reveal flex flex-col bg-[var(--color-surface)] px-4 py-3.5"
              data-delay={`${(i % 4) * 60}ms`}
            >
              <div class="flex items-center gap-2.5">
                <span class="icono-competencia" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={ICONOS_COMPETENCIA[c.area]} />
                  </svg>
                </span>
                <h3 class="font-display text-[0.98rem] leading-tight tracking-tight">{c.area}</h3>
              </div>

              {/* Sin justificar: a esta anchura el justificado abre calles entre
                  palabras. Y sin mt-auto, que dejaba un vacío en las áreas de
                  descripción corta. */}
              <p class="mt-2.5 text-[0.78rem] leading-[1.5] text-[var(--color-ink-soft)]">
                {c.detalle}
              </p>

              <div class="mt-3 flex flex-wrap gap-1">
                {[...c.items]
                  .sort((a, b) => Number(Boolean(LOGOS_ITEM[b])) - Number(Boolean(LOGOS_ITEM[a])))
                  .map((it) => {
                    const marca = marcaDe(it);
                    return (
                      <span class:list={['chip', 'chip-sm', !marca && 'chip-practica']}>
                        {marca && <span class="chip-marca" aria-hidden="true" set:html={marca} />}
                        {it}
                      </span>
                    );
                  })}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LÍNEA DE TIEMPO ============ -->
  <section id="recorrido" class="sector">
    <SectionHeading
      eyebrow="Recorrido"
      title="Etapa por etapa"
      subtitle="De las primeras prácticas al liderazgo técnico. Pulsa una etapa para ver qué hice ahí."
    />

    {/* Índice: una línea por etapa, separadas por filete y sin caja. Sin
        numerar y sin recuadrar los logos: la caja alrededor de cada marca
        pesaba más que la marca. Las marcas van en gris y se encienden al pasar
        el cursor, igual que en el muro de clientes, para que ninguna domine
        sobre las demás en reposo. */}
    <ol class="mt-6">
      {
        experiencias.map((e) => (
          <li>
            <button
              type="button"
              data-etapa={e.cargo}
              aria-haspopup="dialog"
              class="fila-etapa marca rejilla-etapas w-full border-t border-[var(--color-line)] py-[9px] text-left"
            >
              <span class="flex h-6 items-center">
                {e.logo ? (
                  <img
                    src={`/logos/${e.logo}`}
                    alt={`Logo de ${e.empresa}`}
                    width="68"
                    height="22"
                    loading="lazy"
                    class="max-h-[22px] max-w-[68px] object-contain"
                  />
                ) : (
                  <span class="font-display text-sm text-[var(--color-fox-deep)]">
                    {e.empresa.slice(0, 3)}
                  </span>
                )}
              </span>

              <span class="flex min-w-0 flex-col sm:flex-row sm:items-baseline sm:gap-2">
                <span class="min-w-0 shrink truncate font-display text-[0.95rem] leading-tight tracking-tight">
                  {e.cargo}
                </span>
                <span class="hidden shrink-0 text-[var(--color-line-strong)] sm:inline">·</span>
                <span class="mt-0.5 min-w-0 shrink-[8] truncate text-[0.78rem] leading-tight text-[var(--color-faint)] sm:mt-0">
                  {e.empresa}
                </span>
              </span>

              <span class="hidden min-w-0 items-center gap-2 md:flex">
                <img
                  src={`/paises/${e.pais}.png`}
                  alt={`Bandera de ${e.paisNombre}`}
                  width="17"
                  height="11"
                  loading="lazy"
                  class="h-[11px] w-[17px] shrink-0 rounded-[2px] object-cover ring-1 ring-black/10"
                />
                <span class="truncate font-mono text-[0.68rem] text-[var(--color-faint)]">
                  {e.paisNombre}
                  {e.modalidad && ` · ${e.modalidad}`}
                </span>
              </span>

              <span class="hidden min-w-0 lg:block">
                {e.clientes && (
                  <span class="block truncate font-mono text-[0.66rem] text-[var(--color-fox-dark)]">
                    {e.clientes.map((c) => c.nombre).join(' · ')}
                  </span>
                )}
              </span>

              <span class="flecha-etapa" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
                </svg>
              </span>
            </button>
          </li>
        ))
      }
    </ol>

    {/* Un solo diálogo que se rellena al pulsar, como los de cliente y agente. */}
    <dialog
      id="dialogo-etapa"
      tabindex="-1"
      class="dialogo-etapa m-auto w-[min(62rem,94vw)] overflow-hidden rounded-[28px] p-0 backdrop:bg-[rgba(29,23,18,0.55)] backdrop:backdrop-blur-[3px]"
    >
      <header class="cabecera-etapa relative px-7 py-5 md:px-8">
        <button
          type="button"
          id="de-cerrar"
          aria-label="Cerrar"
          class="absolute right-5 top-5 grid h-9 w-9 place-items-center rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] text-[var(--color-ink-soft)] transition-colors hover:border-[var(--color-fox)] hover:text-[var(--color-fox-dark)]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-5 pr-12">
          <span
            id="de-logo"
            class="grid h-16 w-28 shrink-0 place-items-center rounded-2xl border border-[var(--color-line)] bg-white p-3 shadow-[0_10px_24px_-14px_rgba(29,23,18,0.5)]"
          ></span>
          <div class="min-w-0">
            <h3 id="de-cargo" class="font-display text-[1.6rem] leading-tight tracking-tight md:text-[1.8rem]"></h3>
            <p id="de-meta" class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1"></p>
          </div>
        </div>
      </header>

      {/* Dos columnas: el relato a la izquierda y la ficha técnica a la
          derecha, sobre su propio plano. Apilado obligaba a desplazar dentro
          del cuadro para llegar a los gráficos, y lo que no se ve no cuenta. */}
      <div class="cuerpo-etapa">
        <div class="min-w-0 px-7 py-5 md:px-8">
          <p id="de-descripcion" class="texto-justo text-[0.92rem] leading-relaxed text-[var(--color-ink-soft)]"></p>

          <p class="mt-6 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">
            Qué hice ahí
          </p>
          <ul id="de-logros" class="mt-2.5 space-y-2"></ul>
        </div>

        <aside class="ficha-etapa px-7 py-5 md:px-7">
          <div id="de-clientes" class="mb-5"></div>
          <div id="de-productos" class="mb-5"></div>

          {/* Mapa de cobertura: las diez capas posibles, con las que toqué en
              esa etapa encendidas. Se deducen del stack y de los logros de la
              propia etapa, no se declaran a mano por fuera. */}
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">
            Qué cubrí
          </p>
          <ol id="de-capas" class="mapa-capas mt-2.5"></ol>

          <p class="mt-5 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">
            Herramientas
          </p>
          <div id="de-stack" class="mt-2.5 flex flex-wrap gap-1.5"></div>

          {/* Barra del recorrido: trece tramos, uno por etapa, con el de esta
              encendido. Ubica el puesto en la carrera sin escribir una fecha. */}
          <p class="mt-5 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">
            Dónde cae en el recorrido
          </p>
          <div class="mt-2.5">
            <ol id="de-barra" class="barra-recorrido"></ol>
            <div class="mt-1.5 flex justify-between font-mono text-[0.56rem] uppercase tracking-[0.1em] text-[var(--color-faint)]">
              <span>Primeras prácticas</span>
              <span>Hoy</span>
            </div>
          </div>
        </aside>
      </div>

      <footer class="flex items-center justify-between gap-4 border-t border-[var(--color-line)] bg-[var(--color-cream)] px-7 py-3.5 md:px-8">
        <span id="de-indice" class="font-mono text-xs text-[var(--color-faint)]"></span>
        <a
          id="de-web"
          href="#"
          target="_blank"
          rel="noopener"
          class="btn btn-primary shrink-0 !px-5 !py-2.5 text-sm"
        >
          Visitar el sitio
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </footer>
    </dialog>
  </section>

  <!-- Educación + Certificaciones -->
  <section id="formacion" class="sector">
    <SectionHeading
      eyebrow="Formación"
      title="Estudios y certificaciones"
      subtitle="Lo que está acreditado por un tercero, no lo que digo yo."
    />

    {/* Antes eran dos columnas de tarjetas sueltas: la de Educación tenía una
        sola y la otra cinco, así que media pantalla quedaba vacía. Ahora es una
        ficha de tres bloques con el rótulo a la izquierda, que reparte el
        espacio según lo que hay en cada uno y no al revés. */}
    <div class="panel-fases mt-6 overflow-hidden rounded-[26px]">
      <div class="grid gap-px bg-[var(--color-line-strong)]">
        <div class="bloque-formacion bg-[var(--color-surface)]">
          <p class="rotulo-formacion">Educación</p>
          <ul class="grid gap-3">
            {
              educacion.map((ed) => (
                <li class="flex items-start gap-3.5">
                  <span class="icono-formacion" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m12 3.5 10 4.6-10 4.6L2 8.1l10-4.6Z M6 10.4v4.9c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.9" />
                    </svg>
                  </span>
                  <span>
                    <span class="block font-display text-[1.05rem] leading-tight tracking-tight">{ed.titulo}</span>
                    <span class="mt-1 block text-[0.85rem] text-[var(--color-ink-soft)]">{ed.institucion}</span>
                    {ed.periodo && (
                      <span class="mt-1 block font-mono text-[0.7rem] text-[var(--color-faint)]">{ed.periodo}</span>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bloque-formacion bg-[var(--color-surface)]">
          <p class="rotulo-formacion">
            Certificaciones
            <span class="cuenta-formacion">{certificaciones.length}</span>
          </p>
          <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {
              certificaciones.map((c) => (
                <li class="flex items-start gap-3.5">
                  <span class="icono-formacion" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8.4" r="5.4" />
                      <path d="M9.2 13.4 7.4 21l4.6-2.7 4.6 2.7-1.8-7.6" />
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block text-[0.9rem] font-semibold leading-snug">{c.nombre}</span>
                    <span class="mt-0.5 block text-[0.8rem] text-[var(--color-ink-soft)]">
                      {c.emisor}
                      {c.anio && ` · ${c.anio}`}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bloque-formacion bg-[var(--color-surface)]">
          <p class="rotulo-formacion">Idiomas</p>
          <ul class="grid gap-3 sm:grid-cols-2">
            {
              idiomas.map((idioma) => (
                <li class="flex items-start gap-3.5">
                  <span class="icono-formacion" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3.2a8.8 8.8 0 1 0 0 17.6 8.8 8.8 0 0 0 0-17.6Z M3.6 9.2h16.8 M3.6 14.8h16.8 M12 3.2a13.5 13.5 0 0 1 0 17.6 M12 3.2a13.5 13.5 0 0 0 0 17.6" />
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block font-display text-[1rem] leading-tight tracking-tight">{idioma.nombre}</span>
                    <span class="mt-1 block text-[0.82rem] leading-snug text-[var(--color-ink-soft)]">
                      {idioma.nivel}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
        </div>
      </div>
    </div>

    <!-- ============ SIGUIENTE PASO ============ -->
