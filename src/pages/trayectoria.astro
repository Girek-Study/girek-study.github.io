---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../data/site';
import { experiencias, certificaciones, educacion, idiomas } from '../data/experience';
import { cifras, competencias, logrosDestacados, clientes, agentesIA, iaEnElCiclo } from '../data/perfil-extra';

// Los iconos se inlinean para poder teñirlos con el color del texto.
const svgs = import.meta.glob<string>('../herramientas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const modelos = [
  { slug: 'anthropic', nombre: 'Claude (Anthropic)' },
  { slug: 'openai', nombre: 'GPT (OpenAI)' },
  { slug: 'googlegemini', nombre: 'Gemini (Google)' },
  { slug: 'cursor', nombre: 'Cursor' },
  { slug: 'githubcopilot', nombre: 'GitHub Copilot' },
].map((m) => ({ ...m, svg: svgs[`../herramientas/${m.slug}.svg`] }));
---

<Layout
  title={`Trayectoria — ${profile.nombreCompleto}`}
  description={`Trayectoria profesional de ${profile.nombreCompleto} en QA, automatización de pruebas y liderazgo de equipos de calidad.`}
>
  <!-- ============ ENCABEZADO CON FOTO ============ -->
  <section class="relative overflow-hidden pt-28 pb-12 md:pt-36">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <div class="blob -z-10 right-[-4rem] top-16 h-80 w-80" style="background: var(--color-amber)"></div>

    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 md:px-8 lg:grid-cols-[auto_1fr] lg:gap-14">
      <div class="reveal mx-auto lg:mx-0">
        <div class="relative grid place-items-center">
          {/* Halo difuso detrás del recorte: sin él la foto sin fondo queda
              flotando y se nota que está pegada encima de la página. */}
          <span
            class="pointer-events-none absolute h-[86%] w-[86%] rounded-full bg-[radial-gradient(circle,var(--color-fox-tint)_0%,var(--color-amber)_45%,transparent_72%)] opacity-70 blur-2xl"
          ></span>
          <img
            src="/girek-foto.png"
            srcset="/girek-foto-sm.png 360w, /girek-foto.png 720w"
            sizes="(max-width: 1023px) 208px, 288px"
            alt="Giancarlo Renato Palomino Huallpa"
            width="720"
            height="720"
            class="foto-perfil relative h-52 w-52 object-contain sm:h-60 sm:w-60 lg:h-72 lg:w-72"
          />
        </div>
      </div>

      <div class="min-w-0">
        <p class="reveal eyebrow">Trayectoria</p>
        <h1 class="reveal mt-3 font-display text-[clamp(2rem,3.4vw+0.9rem,3.2rem)] leading-[1.05] tracking-tight" data-delay="60ms">
          {profile.nombreCompleto}
        </h1>
        <p class="reveal mt-4 text-lg leading-relaxed text-[var(--color-ink-soft)]" data-delay="100ms">
          Diez años en calidad de software: de programar en Java a liderar chapters de QA en banca,
          fintech, salud y educación.
        </p>

        <div class="reveal mt-6 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-[var(--color-faint)]" data-delay="140ms">
          <span>{profile.cargoActual}</span>
          <span>{profile.ubicacion}</span>
        </div>

        <div class="reveal mt-7 flex flex-wrap gap-3" data-delay="180ms">
          <a href={`mailto:${profile.email}`} class="btn btn-primary text-sm">Escríbeme</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" class="btn btn-ghost text-sm">LinkedIn</a>
          <a href={profile.links.github} target="_blank" rel="noopener" class="btn btn-ghost text-sm">GitHub</a>
          {profile.links.cv && (
            <a href={profile.links.cv} target="_blank" rel="noopener" class="btn btn-ghost text-sm">
              CV en PDF
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CIFRAS ============ -->
  <section class="border-y border-[var(--color-line)] bg-[var(--color-surface)]">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-8 px-5 py-10 md:grid-cols-4 md:px-8">
      {
        cifras.map((c, i) => (
          <div class="reveal" data-delay={`${i * 70}ms`}>
            <dt class="font-display text-4xl text-[var(--color-fox-dark)]">{c.valor}</dt>
            <dd class="mt-1 text-sm leading-snug text-[var(--color-ink-soft)]">{c.etiqueta}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ============ QUIÉN SOY ============ -->
  <section class="mx-auto max-w-4xl px-5 py-14 md:px-8 md:py-20">
    <p class="reveal text-xl leading-snug tracking-tight text-[var(--color-ink)] md:text-[1.6rem]">
      {profile.bio}
    </p>
  </section>

  <!-- ============ LOGROS DESTACADOS ============ -->
  <section class="mx-auto max-w-6xl px-5 pb-14 md:px-8 md:pb-20">
    <SectionHeading
      eyebrow="Resultados"
      title="Lo que se movió cuando estuve"
      subtitle="Cifras del CV, cada una con el contexto en el que ocurrió."
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        logrosDestacados.map((l, i) => (
          <article class="reveal card p-6" data-delay={`${i * 70}ms`}>
            <p class="font-display text-3xl text-[var(--color-fox-dark)]">{l.cifra}</p>
            <h3 class="mt-3 font-semibold leading-snug">{l.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{l.detalle}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ CLIENTES ============ -->
  <section class="mx-auto max-w-6xl px-5 pb-14 md:px-8 md:pb-20">
    <SectionHeading
      eyebrow="Dónde"
      title="Productos que pasaron por mis manos"
      subtitle="Clientes finales de las consultoras y empresas donde trabajé."
    />
    <ul class="mt-10 flex flex-wrap gap-3">
      {
        clientes.map((c, i) => (
          <li
            class="reveal card flex items-center gap-3 px-4 py-3"
            data-delay={`${(i % 5) * 60}ms`}
          >
            {c.logo ? (
              <span class="grid h-7 w-12 shrink-0 place-items-center overflow-hidden rounded-md bg-white px-1">
                <img
                  src={`/logos/${c.logo}`}
                  alt={`Logo de ${c.nombre}`}
                  width="44"
                  height="22"
                  loading="lazy"
                  class="h-full w-full object-contain"
                />
              </span>
            ) : (
              <span class="grid h-7 w-12 shrink-0 place-items-center rounded-md bg-[var(--color-fox-tint)] font-display text-sm text-[var(--color-fox-dark)]">
                {c.nombre.slice(0, 3)}
              </span>
            )}
            <span class="text-sm font-medium">{c.nombre}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ IA APLICADA ============ -->
  <section class="mx-auto max-w-6xl px-5 pb-14 md:px-8 md:pb-20">
    <SectionHeading
      eyebrow="IA aplicada"
      title="Dónde entra la IA en mi trabajo"
      subtitle="No solo generar casos: construir las herramientas que hacen el trabajo repetitivo del equipo, meter modelos dentro del ciclo, y probar productos que llevan IA por dentro."
    />

    <div class="reveal mt-10 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-6 md:p-7">
      <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-faint)]">
        Modelos y herramientas con los que trabajo
      </p>
      <ul class="mt-5 flex flex-wrap items-center gap-x-7 gap-y-4">
        {
          modelos.map((m) => (
            <li class="flex items-center gap-2.5 text-[var(--color-ink-soft)]">
              <span class="herramienta herramienta-md" set:html={m.svg} />
              <span class="text-sm font-medium">{m.nombre}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
        Los uso donde cada uno rinde: razonamiento largo sobre requerimientos, generación de
        código de pruebas dentro del editor, y comparación de estructuras. La herramienta cambia
        cada seis meses; el criterio para decidir qué se acepta y qué se descarta, no.
      </p>
    </div>

    <h3 class="reveal mt-12 font-display text-2xl tracking-tight">Agentes y herramientas que construí</h3>
    <p class="reveal mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-ink-soft)]" data-delay="60ms">
      Software propio, en producción y en uso por el equipo. No demos.
    </p>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      {
        agentesIA.map((a, i) => (
          <article class="reveal card p-6 md:p-7" data-delay={`${(i % 2) * 80}ms`}>
            <div class="flex items-start justify-between gap-4">
              <h4 class="font-display text-lg leading-snug tracking-tight">{a.titulo}</h4>
              <span class="shrink-0 rounded-full bg-[var(--color-fox-tint)] px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-fox-dark)]">
                {a.contexto}
              </span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{a.detalle}</p>
          </article>
        ))
      }
    </div>

    <h3 class="reveal mt-14 font-display text-2xl tracking-tight">IA dentro del ciclo de pruebas</h3>
    <p class="reveal mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-ink-soft)]" data-delay="60ms">
      Aplicado en proyectos de cliente, con una regla fija: ninguna salida del modelo se
      convierte en un caso ejecutable ni en un defecto reportado sin revisión humana.
    </p>
    <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        iaEnElCiclo.map((a, i) => (
          <li class="reveal card flex flex-col p-6" data-delay={`${(i % 3) * 70}ms`}>
            <span class="font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-faint)]">
              {a.contexto}
            </span>
            <h4 class="mt-2 font-semibold leading-snug">{a.titulo}</h4>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{a.detalle}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ COMPETENCIAS ============ -->
  <section class="mx-auto max-w-6xl px-5 pb-14 md:px-8 md:pb-20">
    <SectionHeading
      eyebrow="Qué sé hacer"
      title="Competencias"
      subtitle="Lo que defiendo en una entrevista técnica, agrupado por para qué sirve."
    />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        competencias.map((c, i) => (
          <article class="reveal card p-6 md:p-7" data-delay={`${(i % 2) * 80}ms`}>
            <h3 class="font-display text-xl tracking-tight">{c.area}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{c.detalle}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {c.items.map((it) => (
                <span class="chip">{it}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ LÍNEA DE TIEMPO ============ -->
  <section class="mx-auto max-w-6xl px-5 pb-6 md:px-8">
    <SectionHeading
      eyebrow="Recorrido"
      title="Etapa por etapa"
      subtitle="De las primeras prácticas al liderazgo técnico, en orden."
    />
  </section>

  <!-- Timeline -->
  <section class="mx-auto max-w-6xl px-5 pb-12 md:px-8">
    <ol class="relative border-l-2 border-[var(--color-line-strong)] pl-6 md:pl-10">
      {
        experiencias.map((e, i) => (
          <li class="reveal relative pb-12 last:pb-0" data-delay={`${i * 60}ms`}>
            <span class="absolute -left-[33px] top-1.5 grid h-4 w-4 place-items-center rounded-full bg-[var(--color-fox)] shadow-[0_0_0_4px_var(--color-cream)] md:-left-[49px]">
              <span class="h-1.5 w-1.5 rounded-full bg-white" />
            </span>
            <div class="card card-hover p-6 md:p-7">
              <div class="flex items-start gap-4">
                {/* Logo de la empresa, o monograma cuando no hay uno usable.
                    El hueco es rectangular a propósito: unos logos son
                    isotipos cuadrados y otros son logotipos largos. */}
                <span class="grid h-14 w-[92px] shrink-0 place-items-center overflow-hidden rounded-xl border border-[var(--color-line)] bg-white px-2 py-1.5">
                  {e.logo ? (
                    <img
                      src={`/logos/${e.logo}`}
                      alt={`Logo de ${e.empresa}`}
                      width="84"
                      height="44"
                      loading="lazy"
                      class="h-full w-full object-contain"
                    />
                  ) : (
                    <span class="font-display text-2xl text-[var(--color-fox-deep)]">{e.empresa.charAt(0)}</span>
                  )}
                </span>

                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-xl leading-tight tracking-tight">{e.cargo}</h3>

                  <p class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm">
                    {e.web ? (
                      <a
                        href={e.web}
                        target="_blank"
                        rel="noopener"
                        class="link-underline font-semibold text-[var(--color-fox-deep)]"
                      >
                        {e.empresa}
                      </a>
                    ) : (
                      <span class="font-semibold text-[var(--color-fox-deep)]">{e.empresa}</span>
                    )}

                    <span class="inline-flex items-center gap-1.5 text-[var(--color-faint)]">
                      <img
                        src={`/paises/${e.pais}.png`}
                        alt={`Bandera de ${e.paisNombre}`}
                        width="18"
                        height="12"
                        loading="lazy"
                        class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10"
                      />
                      <span class="font-mono text-xs">{e.paisNombre}</span>
                    </span>

                    {e.modalidad && (
                      <span class="font-mono text-xs text-[var(--color-faint)]">· {e.modalidad}</span>
                    )}
                  </p>
                </div>
              </div>

              {e.clientes && (
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  <span class="font-mono text-xs uppercase tracking-wide text-[var(--color-faint)]">
                    {e.clientes.length > 1 ? 'Clientes' : 'Cliente'}
                  </span>
                  {e.clientes.map((c) => (
                    <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-fox-tint)] py-1 pl-1.5 pr-3">
                      {c.logo && (
                        /* Rectangular, no circular: varios logos de cliente son
                           logotipos largos y dentro de un círculo se aplastan. */
                        <span class="grid h-6 w-11 place-items-center overflow-hidden rounded-md bg-white px-1">
                          <img
                            src={`/logos/${c.logo}`}
                            alt={`Logo de ${c.nombre}`}
                            width="40"
                            height="20"
                            loading="lazy"
                            class="h-full w-full object-contain"
                          />
                        </span>
                      )}
                      <span class="text-xs font-semibold text-[var(--color-fox-deep)]">{c.nombre}</span>
                    </span>
                  ))}
                </div>
              )}

              <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-soft)]">{e.descripcion}</p>
              <ul class="mt-4 space-y-2">
                {e.logros.map((l) => (
                  <li class="flex gap-2.5 text-sm text-[var(--color-ink-soft)]">
                    <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-[var(--color-fox)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7" /></svg>
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
              {e.stack && (
                <div class="mt-5 flex flex-wrap gap-1.5">
                  {e.stack.map((s) => <span class="chip">{s}</span>)}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Educación + Certificaciones -->
  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <div class="grid gap-10 md:grid-cols-2 md:gap-16">
      <div class="reveal">
        <h2 class="eyebrow mb-5">Educación</h2>
        <ul class="space-y-4">
          {
            educacion.map((ed) => (
              <li class="card card-hover p-5">
                <h3 class="font-display text-lg tracking-tight">{ed.titulo}</h3>
                <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{ed.institucion}</p>
                {ed.periodo && <p class="mt-1 font-mono text-xs text-[var(--color-faint)]">{ed.periodo}</p>}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal" data-delay="120ms">
        <h2 class="eyebrow mb-5">Certificaciones</h2>
        <ul class="space-y-4">
          {
            certificaciones.map((c) => (
              <li class="card card-hover flex items-center gap-4 p-5">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--color-fox-tint)] text-[var(--color-fox-deep)]">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6" /><path d="M9 13.5 7 22l5-3 5 3-2-8.5" /></svg>
                </span>
                <div>
                  <h3 class="font-medium">{c.nombre}</h3>
                  <p class="text-sm text-[var(--color-ink-soft)]">{c.emisor}{c.anio && ` · ${c.anio}`}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <h2 class="eyebrow mb-5 mt-10">Idiomas</h2>
        <ul class="space-y-4">
          {
            idiomas.map((idioma) => (
              <li class="card p-5">
                <h3 class="font-display text-lg tracking-tight">{idioma.nombre}</h3>
                <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{idioma.nivel}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>
