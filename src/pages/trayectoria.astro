  <script>
    // La ficha lateral aparece cuando el encabezado deja la pantalla: da la
    // sensación de que la presentación se recoge a un lado en vez de
    // materializarse de golpe a media página.
    const encabezado = document.querySelector('.perfil');
    const ficha = document.getElementById('ficha');

    if (encabezado && ficha && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entrada]) => ficha.classList.toggle('ficha-visible', !entrada.isIntersecting),
        { threshold: 0, rootMargin: '-30% 0px 0px 0px' }
      );
      io.observe(encabezado);
    } else {
      ficha?.classList.add('ficha-visible');
    }

    /* El índice resalta el bloque que se está leyendo. Se elige el que está
     * más arriba dentro de la pantalla, no el primero que entra: con bloques
     * de varias pantallas, lo segundo salta de un lado a otro. */
    const enlacesIndice = [...document.querySelectorAll('.indice-enlace')];
    const bloques = enlacesIndice
      .map((a) => document.getElementById(a.dataset.indice))
      .filter(Boolean);

    if (bloques.length) {
      const marcarActivo = () => {
        const linea = window.innerHeight * 0.3;
        let actual = null;
        for (const b of bloques) {
          if (b.getBoundingClientRect().top <= linea) actual = b.id;
        }
        enlacesIndice.forEach((a) => a.classList.toggle('activo', a.dataset.indice === actual));
      };
      marcarActivo();
      window.addEventListener('scroll', marcarActivo, { passive: true });
    }


    /* Navegación por sectores.
     *
     * Un gesto lleva al sector siguiente. Los sectores que no caben en una
     * pantalla —los agentes, las competencias y el recorrido— se recorren
     * primero por dentro y solo saltan cuando se llega a su final: lo
     * contrario obligaría a comprimir el contenido hasta hacerlo ilegible.
     *
     * Va en JavaScript y no con scroll-snap de CSS porque `mandatory` no puede
     * anclar un elemento más alto que la ventana, que es justo el caso de esos
     * tres sectores.
     */
    const sectores = [document.querySelector('.perfil'), ...document.querySelectorAll('.sector'), document.getElementById('cierre')].filter(Boolean);

    const anchoSuficiente = window.matchMedia('(min-width: 1024px)');
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    let navegando = false;

    const topeDe = (el) => Math.round(el.getBoundingClientRect().top + window.scrollY);

    function sectorActual() {
      const y = window.scrollY + 4;
      let indice = 0;
      sectores.forEach((s, i) => {
        if (topeDe(s) <= y) indice = i;
      });
      return indice;
    }

    function irASector(indice) {
      const destino = sectores[indice];
      if (!destino) return;
      navegando = true;
      window.scrollTo({ top: topeDe(destino), behavior: 'smooth' });
      setTimeout(() => (navegando = false), 750);
    }

    window.addEventListener(
      'wheel',
      (evento) => {
        if (navegando || !anchoSuficiente.matches || sinMovimiento.matches) return;
        if (Math.abs(evento.deltaY) < 4) return;
        // Dentro del carrusel del recorrido el gesto es para moverlo a él.
        if (evento.target.closest('.carrusel')) return;

        const i = sectorActual();
        const actual = sectores[i];
        const arriba = topeDe(actual);
        const alto = actual.getBoundingClientRect().height;
        const sobraPorDentro = alto - window.innerHeight;
        const recorrido = window.scrollY - arriba;

        if (evento.deltaY > 0) {
          // Si el sector es más alto que la ventana, primero se termina de leer.
          if (sobraPorDentro > 8 && recorrido < sobraPorDentro - 8) return;
          if (i < sectores.length - 1) {
            evento.preventDefault();
            irASector(i + 1);
          }
        } else {
          if (sobraPorDentro > 8 && recorrido > 8) return;
          if (i > 0) {
            evento.preventDefault();
            irASector(i - 1);
          }
        }
      },
      { passive: false }
    );
  </script>
