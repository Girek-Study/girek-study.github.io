  </div>

  <script type="application/json" id="datos-capas" set:html={JSON.stringify(CAPAS)} is:inline />
  <script type="application/json" id="datos-marcas" set:html={JSON.stringify(Object.fromEntries(Object.keys(LOGOS_ITEM).map((k) => [k, marcaDe(k)]).filter(([, v]) => v)))} is:inline />
  <script type="application/json" id="datos-etapas" set:html={JSON.stringify(experiencias)} is:inline />
  <script type="application/json" id="datos-fases" set:html={JSON.stringify(ciclo.map((c) => c.etapa))} is:inline />
  <script type="application/json" id="datos-agentes" set:html={JSON.stringify(agentesIA)} is:inline />
  <script type="application/json" id="datos-agentes-iconos" set:html={JSON.stringify(ICONOS_AGENTE)} is:inline />
  <script type="application/json" id="datos-clientes" set:html={JSON.stringify(clientesParaModal)} is:inline />

  <script>
    // La ficha lateral aparece cuando el encabezado deja la pantalla: da la
    // sensación de que la presentación se recoge a un lado en vez de
    // materializarse de golpe a media página.
    const encabezado = document.querySelector('.perfil');
    const ficha = document.getElementById('ficha');

    const cierre = document.getElementById('cierre');

    if (encabezado && ficha && 'IntersectionObserver' in window) {
      let pasadoElEncabezado = false;
      let enElCierre = false;

      const decidir = () =>
        ficha.classList.toggle('ficha-visible', pasadoElEncabezado && !enElCierre);

      new IntersectionObserver(
        ([entrada]) => {
          pasadoElEncabezado = !entrada.isIntersecting;
          decidir();
        },
        { threshold: 0, rootMargin: '-30% 0px 0px 0px' }
      ).observe(encabezado);

      if (cierre) {
        new IntersectionObserver(
          ([entrada]) => {
            enElCierre = entrada.isIntersecting;
            decidir();
          },
          // El pie del root sube al 45%: el cierre solo cuenta cuando su borde
          // superior ya entró en la mitad de arriba de la pantalla. Con
          // threshold 0 se apagaba en cuanto asomaba, y la ficha desaparecía
          // mientras aún se estaba leyendo Formación.
          { threshold: 0, rootMargin: '0px 0px -55% 0px' }
        ).observe(cierre);
      }
    } else {
      ficha?.classList.add('ficha-visible');
    }


    /* Detalle de la etapa. Mismo patrón que los otros dos diálogos: un solo
     * <dialog> que se rellena al pulsar, y los datos en un JSON. */
    const ETAPAS = JSON.parse(document.getElementById('datos-etapas').textContent);
    const LISTA_CAPAS = JSON.parse(document.getElementById('datos-capas').textContent);
    const MARCAS_ITEM = JSON.parse(document.getElementById('datos-marcas').textContent);
    const dlgEtapa = document.getElementById('dialogo-etapa');

    if (dlgEtapa && ETAPAS) {
      const ponE = (id, html) => (document.getElementById(id).innerHTML = html);
      const chipE = (contenido) =>
        `<span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-2.5 py-1 text-[0.7rem] font-medium text-[var(--color-ink-soft)]">${contenido}</span>`;

      document.querySelectorAll('[data-etapa]').forEach((boton) => {
        boton.addEventListener('click', () => {
          const i = ETAPAS.findIndex((x) => x.cargo === boton.dataset.etapa);
          const e = ETAPAS[i];
          if (!e) return;

          ponE('de-logo', `<img src="/logos/${e.logo}" alt="Logo de ${e.empresa}" class="max-h-10 max-w-[88px] object-contain">`);
          ponE('de-cargo', e.cargo);
          ponE(
            'de-meta',
            `<span class="font-semibold text-[var(--color-fox-deep)]">${e.empresa}</span>` +
              chipE(
                `<img src="/paises/${e.pais}.png" alt="" width="15" height="10" class="h-2.5 w-[15px] rounded-[1px] object-cover ring-1 ring-black/10"> ${e.paisNombre}`
              ) +
              (e.modalidad ? chipE(e.modalidad) : '') +
              (e.nota ? chipE(e.nota) : '')
          );

          ponE(
            'de-clientes',
            e.clientes && e.clientes.length
              ? `<p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">${
                  e.clientes.length > 1 ? 'Clientes' : 'Cliente'
                }</p>
                 <div class="mt-2 flex flex-wrap items-center gap-2">${e.clientes
                   .map(
                     (c) =>
                       `<span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-fox-tint)] py-1 pl-1.5 pr-3">${
                         c.logo
                           ? `<span class="grid h-6 w-11 place-items-center overflow-hidden rounded-md bg-white px-1"><img src="/logos/${c.logo}" alt="Logo de ${c.nombre}" class="max-h-6 max-w-9 object-contain"></span>`
                           : ''
                       }<span class="text-xs font-semibold text-[var(--color-fox-deep)]">${c.nombre}</span></span>`
                   )
                   .join('')}</div>`
              : ''
          );

          // Productos del propio negocio. No son clientes, y mezclarlos en el
          // mismo bloque diría algo falso sobre para quién se trabajó.
          ponE(
            'de-productos',
            e.productos && e.productos.length
              ? `<p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">Productos</p>
                 <div class="mt-2.5 flex flex-wrap items-center gap-2">${e.productos
                   .map(
                     (x) =>
                       `<span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-fox-tint)] py-1 pl-1.5 pr-3">${
                         x.logo
                           ? `<span class="grid h-6 w-11 place-items-center overflow-hidden rounded-md bg-white px-1"><img src="/logos/${x.logo}" alt="Logo de ${x.nombre}" class="max-h-6 max-w-9 object-contain"></span>`
                           : `<span class="grid h-6 w-11 place-items-center rounded-md bg-white font-display text-[0.7rem] text-[var(--color-fox-deep)]">${x.nombre.slice(0, 3)}</span>`
                       }<span class="text-xs font-semibold text-[var(--color-fox-deep)]">${x.nombre}</span></span>`
                   )
                   .join('')}</div>`
              : ''
          );

          ponE('de-descripcion', e.descripcion);
          ponE(
            'de-logros',
            e.logros
              .map(
                (l) =>
                  `<li class="flex gap-3 text-[0.85rem] leading-[1.55] text-[var(--color-ink-soft)]">
                     <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--color-fox-tint)]">
                       <svg class="h-3 w-3 text-[var(--color-fox-dark)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2"><path d="M5 12l5 5L20 7"/></svg>
                     </span>
                     <span>${l}</span>
                   </li>`
              )
              .join('')
          );
          ponE(
            'de-stack',
            (e.stack || [])
              .map((x) => {
                const marca = MARCAS_ITEM[x];
                return `<span class="chip chip-sm${marca ? '' : ' chip-practica'}">${
                  marca ? `<span class="chip-marca" aria-hidden="true">${marca}</span>` : ''
                }${x}</span>`;
              })
              .join('')
          );

          const suyas = e.capas || [];
          ponE(
            'de-capas',
            LISTA_CAPAS.map(
              (capa) =>
                `<li class="capa${suyas.includes(capa) ? ' activa' : ''}">${capa}</li>`
            ).join('')
          );

          // Todos los tramos iguales salvo el de esta etapa: distinguir
          // "antes" de "después" no significa nada en una carrera ya recorrida,
          // y la barra solo tiene que situar el puesto en la secuencia.
          ponE(
            'de-barra',
            ETAPAS.map((_, n) => `<li class="tramo${n === i ? ' actual' : ''}"></li>`)
              .reverse()
              .join('')
          );
          ponE('de-indice', `Etapa ${ETAPAS.length - i} de ${ETAPAS.length}`);

          const web = document.getElementById('de-web');
          web.href = e.web || '#';
          web.hidden = !e.web;

          dlgEtapa.showModal();
          dlgEtapa.focus();
        });
      });

      document.getElementById('de-cerrar').addEventListener('click', () => dlgEtapa.close());
      dlgEtapa.addEventListener('click', (ev) => {
        if (ev.target === dlgEtapa) dlgEtapa.close();
      });
    }


    /* Modelo conceptual del agente. Mismo patrón que el de clientes: los
     * datos viajan en un JSON y el diálogo se rellena al pulsar. */
    const AGENTES = JSON.parse(document.getElementById('datos-agentes').textContent);
    const TRAZOS = JSON.parse(document.getElementById('datos-agentes-iconos').textContent);
    const FASES_CICLO = JSON.parse(document.getElementById('datos-fases').textContent);
    const dlgAgente = document.getElementById('dialogo-agente');

    if (dlgAgente && AGENTES) {
      const ponA = (id, html) => (document.getElementById(id).innerHTML = html);

      /* Abanico de conectores. El trazado depende de cuántos nodos haya al
       * lado ancho, así que se calcula aquí y no se deja fijo en el CSS.
       * El lienzo se estira con preserveAspectRatio="none"; el grosor del
       * trazo se salva de esa deformación con vector-effect. */
      const abanico = (n, hacia) => {
        const curvas = Array.from({ length: n }, (_, i) => {
          const y = ((i + 0.5) / n) * 100;
          return hacia === 'nucleo'
            ? `M0 ${y} C 55 ${y}, 45 50, 100 50`
            : `M0 50 C 55 50, 45 ${y}, 100 ${y}`;
        })
          .map(
            (d) =>
              `<path d="${d}" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.25" vector-effect="non-scaling-stroke"/>`
          )
          .join('');

        return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">${curvas}</svg>`;
      };

      const nodos = (xs) =>
        xs.map((x) => `<div class="nodo"><span></span>${x}</div>`).join('');

      document.querySelectorAll('[data-agente]').forEach((boton) => {
        boton.addEventListener('click', () => {
          const i = AGENTES.findIndex((x) => x.titulo === boton.dataset.agente);
          const a = AGENTES[i];
          if (!a) return;

          const trazo = TRAZOS[a.icono || 'panel'];
          const icono = (clase) =>
            `<svg class="${clase}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"><path d="${trazo}"/></svg>`;

          ponA('da-icono', icono(''));
          ponA('da-nucleo-icono', icono(''));
          ponA('da-contexto', a.contexto);
          ponA('da-titulo', a.titulo);
          ponA('da-detalle', a.detalle);

          const f = a.flujo || { entrada: [], proceso: [], salida: [] };
          ponA('da-entrada', nodos(f.entrada));
          ponA('da-salida', nodos(f.salida));
          ponA('da-proceso', f.proceso.map((x) => `<li>${x}</li>`).join(''));
          ponA('da-con-1', abanico(f.entrada.length, 'nucleo'));
          ponA('da-con-2', abanico(f.salida.length, 'salida'));

          const suyas = a.fases || [];
          ponA(
            'da-mapa',
            FASES_CICLO.map(
              (fase, n) =>
                `<li class="paso-ciclo${suyas.includes(fase) ? ' activo' : ''}">
                   <span class="paso-num">${String(n + 1).padStart(2, '0')}</span>
                   <span class="paso-nombre">${fase}</span>
                 </li>`
            ).join('')
          );

          ponA(
            'da-indice',
            `${String(i + 1).padStart(2, '0')} / ${String(AGENTES.length).padStart(2, '0')}`
          );

          dlgAgente.showModal();
          dlgAgente.focus();
        });
      });

      document.getElementById('da-cerrar').addEventListener('click', () => dlgAgente.close());
      // Pulsar fuera de la tarjeta cierra: el backdrop es el propio <dialog>.
      dlgAgente.addEventListener('click', (e) => {
        if (e.target === dlgAgente) dlgAgente.close();
      });
    }


    /* Detalle del cliente. Los datos viajan en un JSON dentro del HTML en vez
     * de repetirse en cada botón: es un solo lugar que mantener. */
    const CLIENTES = JSON.parse(document.getElementById('datos-clientes').textContent);
    const dialogo = document.getElementById('dialogo-cliente');

    if (dialogo && CLIENTES) {
      const pon = (id, html) => (document.getElementById(id).innerHTML = html);
      const chip = (contenido) =>
        `<span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-2.5 py-1 text-[0.7rem] font-medium text-[var(--color-ink-soft)]">${contenido}</span>`;

      document.querySelectorAll('[data-cliente]').forEach((boton) => {
        boton.addEventListener('click', () => {
          const c = CLIENTES.find((x) => x.nombre === boton.dataset.cliente);
          if (!c) return;

          pon(
            'dc-logo',
            c.logo
              ? `<img src="/logos/${c.logo}" alt="Logo de ${c.nombre}" class="max-h-10 w-auto max-w-[4.5rem] object-contain">`
              : `<span class="font-display text-lg text-[var(--color-ink-soft)]">${c.nombre.slice(0, 3)}</span>`
          );
          pon('dc-nombre', c.nombre);
          pon(
            'dc-meta',
            chip(
              `<img src="/paises/${c.pais}.png" alt="" width="15" height="10" class="h-2.5 w-[15px] rounded-[1px] object-cover ring-1 ring-black/10"> ${c.paisNombre}`
            ) + chip(c.sector)
          );

          pon(
            'dc-via',
            c.via
              ? `<p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">Desde</p>
                 <p class="mt-1.5 font-display text-lg tracking-tight">${c.via}</p>`
              : ''
          );

          pon(
            'dc-logros',
            c.logros && c.logros.length
              ? `<p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">Qué hice ahí</p>
                 <ul class="mt-3 space-y-3">${c.logros
                   .map(
                     (l) =>
                       `<li class="flex gap-3 text-[0.92rem] leading-relaxed text-[var(--color-ink-soft)]">
                          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--color-fox-tint)]">
                            <svg class="h-3 w-3 text-[var(--color-fox-dark)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2"><path d="M5 12l5 5L20 7"/></svg>
                          </span>
                          <span>${l}</span>
                        </li>`
                   )
                   .join('')}</ul>`
              : `<p class="rounded-2xl border border-dashed border-[var(--color-line-strong)] px-5 py-4 text-sm leading-relaxed text-[var(--color-faint)]">
                   Trabajo de aseguramiento de calidad en ${c.sector.toLowerCase()}. El detalle de esta cuenta no está publicado.
                 </p>`
          );

          document.getElementById('dc-web').href = c.web;
          pon('dc-dominio', new URL(c.web).hostname.replace(/^www\./, ''));

          dialogo.showModal();
        });
      });

      document.getElementById('dc-cerrar').addEventListener('click', () => dialogo.close());
      // Pulsar fuera del cuadro también cierra.
      dialogo.addEventListener('click', (evento) => {
        if (evento.target === dialogo) dialogo.close();
      });
    }

    /* Bloqueo del fondo mientras hay un diálogo abierto.
     *
     * showModal() atrapa el foco y pinta el backdrop, pero no impide que la
     * rueda siga desplazando la página: el sector de detrás se movía bajo el
     * cuadro. Se observa el atributo `open` porque <dialog> no emite ningún
     * evento al abrirse, solo al cerrarse. */
    const raiz = document.documentElement;

    function ajustarFondo() {
      const hayDialogo = !!document.querySelector('dialog[open]');
      if (hayDialogo) {
        // Al ocultar la barra de desplazamiento el ancho útil crece y la página
        // pega un salto; se compensa con el hueco que deja.
        const hueco = window.innerWidth - raiz.clientWidth;
        raiz.style.setProperty('--compensa-barra', `${hueco}px`);
      }
      raiz.classList.toggle('con-dialogo', hayDialogo);
    }

    document.querySelectorAll('dialog').forEach((cuadro) => {
      new MutationObserver(ajustarFondo).observe(cuadro, {
        attributes: true,
        attributeFilter: ['open'],
      });
    });


    /* El índice resalta el bloque que se está leyendo. Se elige el que está
     * más arriba dentro de la pantalla, no el primero que entra: con bloques
     * de varias pantallas, lo segundo salta de un lado a otro. */
    const enlacesIndice = [...document.querySelectorAll('.indice-enlace')];
    const bloques = enlacesIndice
      .map((a) => document.getElementById(a.dataset.indice))
      .filter(Boolean);

    if (bloques.length) {
      const marcarActivo = () => {
        const linea = window.innerHeight * 0.3;
        let actual = null;
        for (const b of bloques) {
          if (b.getBoundingClientRect().top <= linea) actual = b.id;
        }
        enlacesIndice.forEach((a) => a.classList.toggle('activo', a.dataset.indice === actual));
      };
      marcarActivo();
      window.addEventListener('scroll', marcarActivo, { passive: true });
    }


    /* Navegación por sectores.
     *
     * Un gesto lleva al sector siguiente. Los sectores que no caben en una
     * pantalla —los agentes, las competencias y el recorrido— se recorren
     * primero por dentro y solo saltan cuando se llega a su final: lo
     * contrario obligaría a comprimir el contenido hasta hacerlo ilegible.
     *
     * Va en JavaScript y no con scroll-snap de CSS porque `mandatory` no puede
     * anclar un elemento más alto que la ventana, que es justo el caso de esos
     * tres sectores.
     */
    const sectores = [document.querySelector('.perfil'), ...document.querySelectorAll('.sector'), document.getElementById('cierre')].filter(Boolean);

    const anchoSuficiente = window.matchMedia('(min-width: 1024px)');
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    let navegando = false;

    const topeDe = (el) => Math.round(el.getBoundingClientRect().top + window.scrollY);

    function sectorActual() {
      const y = window.scrollY + 4;
      let indice = 0;
      sectores.forEach((s, i) => {
        if (topeDe(s) <= y) indice = i;
      });
      return indice;
    }

    function irASector(indice) {
      const destino = sectores[indice];
      if (!destino) return;
      navegando = true;
      window.scrollTo({ top: topeDe(destino), behavior: 'smooth' });
      setTimeout(() => (navegando = false), 750);
    }

    window.addEventListener(
      'wheel',
      (evento) => {
        if (navegando || !anchoSuficiente.matches || sinMovimiento.matches) return;
        // Con un diálogo abierto la rueda es para el diálogo, no para la página.
        if (document.querySelector('dialog[open]')) return;
        if (Math.abs(evento.deltaY) < 4) return;
        const i = sectorActual();
        const actual = sectores[i];
        const arriba = topeDe(actual);
        const alto = actual.getBoundingClientRect().height;
        const sobraPorDentro = alto - window.innerHeight;
        const recorrido = window.scrollY - arriba;

        if (evento.deltaY > 0) {
          // Si el sector es más alto que la ventana, primero se termina de leer.
          if (sobraPorDentro > 8 && recorrido < sobraPorDentro - 8) return;
          if (i < sectores.length - 1) {
            evento.preventDefault();
            irASector(i + 1);
          }
        } else {
          if (sobraPorDentro > 8 && recorrido > 8) return;
          if (i > 0) {
            evento.preventDefault();
            irASector(i - 1);
          }
        }
      },
      { passive: false }
    );

    /* Lo mismo en táctil, por otro camino.
     *
     * En un móvil no hay rueda que interceptar, y frenar el dedo a media
     * pasada pelea con el desplazamiento por inercia: se siente como si la
     * página se resistiera. Así que aquí no se intercepta el gesto — se espera
     * a que termine y, solo si el sector quedó cerca, se termina de encajar.
     *
     * El imán tiene alcance corto a propósito: si alguien paró en mitad de un
     * sector para leer, ahí se queda. */
    const IMAN = 0.2; // proporción de la ventana dentro de la que sí se ajusta

    function encajarSector() {
      if (navegando || anchoSuficiente.matches || sinMovimiento.matches) return;
      if (document.querySelector('dialog[open]')) return;

      const y = window.scrollY;
      // Abajo del todo no hay nada que encajar: se quedaría peleando con el
      // tope de la página.
      if (y + window.innerHeight >= document.body.scrollHeight - 2) return;

      let cerca = null;
      sectores.forEach((sector) => {
        const distancia = topeDe(sector) - y;
        if (Math.abs(distancia) < window.innerHeight * IMAN) {
          if (!cerca || Math.abs(distancia) < Math.abs(cerca.distancia)) {
            cerca = { sector, distancia };
          }
        }
      });

      if (!cerca || Math.abs(cerca.distancia) < 6) return;
      navegando = true;
      window.scrollTo({ top: topeDe(cerca.sector), behavior: 'smooth' });
      setTimeout(() => (navegando = false), 700);
    }

    // `scrollend` avisa cuando el gesto y su inercia terminaron. Donde no
    // existe todavía, se aproxima con un respiro sin movimiento.
    if ('onscrollend' in window) {
      window.addEventListener('scrollend', encajarSector);
    } else {
      let reposo;
      window.addEventListener(
        'scroll',
        () => {
          clearTimeout(reposo);
          reposo = setTimeout(encajarSector, 140);
        },
        { passive: true }
      );
    }
  </script>
</Layout>
