---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../data/site';
import { experiencias, certificaciones, educacion, idiomas } from '../data/experience';
import {
  cifras,
  competencias,
  logrosDestacados,
  clientes,
  NOMBRE_PAIS,
  agentesIA,
  iaEnElCiclo,
} from '../data/perfil-extra';

// Los iconos se inlinean para poder teñirlos con el color del texto.
const svgs = import.meta.glob<string>('../herramientas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const modelos = [
  { slug: 'anthropic', nombre: 'Claude (Anthropic)' },
  { slug: 'openai', nombre: 'GPT (OpenAI)' },
  { slug: 'googlegemini', nombre: 'Gemini (Google)' },
  { slug: 'cursor', nombre: 'Cursor' },
  { slug: 'githubcopilot', nombre: 'GitHub Copilot' },
].map((m) => ({ ...m, svg: svgs[`../herramientas/${m.slug}.svg`] }));

const clientesParaModal = clientes.map((c) => ({ ...c, paisNombre: NOMBRE_PAIS[c.pais] }));

// Se calculan de la lista para que nunca se contradigan con la rejilla.
const metricasClientes = [
  { valor: String(clientes.length), etiqueta: 'clientes finales' },
  {
    valor: String(clientes.filter((c) => c.sector === 'Banca' || c.sector === 'Seguros').length),
    etiqueta: 'del sistema financiero',
  },
  { valor: String(clientes.filter((c) => c.sector === 'Gobierno').length), etiqueta: 'organismos del Estado' },
  { valor: String(new Set(clientes.map((c) => c.sector)).size), etiqueta: 'sectores distintos' },
];

const contacto = [
  { slug: 'whatsapp', texto: 'Escríbeme', href: profile.whatsappUrl, principal: true },
  { slug: 'linkedin', texto: 'LinkedIn', href: profile.links.linkedin, principal: false },
  { slug: 'github', texto: 'GitHub', href: profile.links.github, principal: false },
  // En móvil la dirección entera no cabe en el botón y se cortaba a media
  // palabra; el rótulo corto entra hasta que hay sitio para la de verdad.
  { slug: 'gmail', texto: profile.email, textoCorto: 'Correo', href: `mailto:${profile.email}`, principal: false },
].map((c) => ({ ...c, svg: svgs[`../herramientas/${c.slug}.svg`] }));

// Nueve entran en una fila del ancho de la columna; con diez, la última
// caía sola a un segundo renglón.
// Trazos de los iconos del índice lateral.
const ICONOS_INDICE: Record<string, string> = {
  presentacion: 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
  resultados: 'M3 17l6-6 4 4 8-8 M21 7v5h-5',
  clientes: 'M3 21h18 M6 21V8l6-4 6 4v13 M10 21v-5h4v5',
  ia: 'M9 3v2 M15 3v2 M9 19v2 M15 19v2 M3 9h2 M3 15h2 M19 9h2 M19 15h2 M6 6h12v12H6z M10 10h4v4h-4z',
  competencias: 'm12 2 9 5-9 5-9-5 9-5Z M3 12l9 5 9-5 M3 17l9 5 9-5',
  recorrido: 'M12 7v5l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  formacion: 'm12 3 10 5-10 5L2 8l10-5Z M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5',
};

const herramientasDiarias = [
  'playwright', 'typescript', 'cucumber', 'k6', 'postman',
  'azuredevops', 'docker', 'jenkins', 'gitlab',
].map((slug) => svgs[`../herramientas/${slug}.svg`]);

// Trazos de los iconos de las cifras. Inline y no una librería: son cuatro.
const ICONOS: Record<string, string> = {
  reloj: 'M12 7v5l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  chip: 'M9 3v2 M15 3v2 M9 19v2 M15 19v2 M3 9h2 M3 15h2 M19 9h2 M19 15h2 M6 6h12v12H6z M10 10h4v4h-4z',
  grafico: 'M3 6l7 7 4-4 7 7 M21 16v4h-4',
  globo: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3.6 9h16.8 M3.6 15h16.8 M12 3a14 14 0 0 1 0 18 M12 3a14 14 0 0 0 0 18',
};

// Un trazo por agente. Line-icons de 24x24, mismo grosor que el resto del
// sitio: rotulan la tarjeta de un vistazo sin competir con el titular.
// La última de iaEnElCiclo no es una fase del ciclo sino un producto que
// lleva IA dentro; se saca aquí para que la plantilla no tenga que saberlo.
const ciclo = iaEnElCiclo.slice(0, -1);
const aparte = iaEnElCiclo[iaEnElCiclo.length - 1];

// Marca de cada herramienta, para los chips de competencias. Solo entran
// productos. Shift-Left, Risk-based testing o Page Object Model no tienen
// logotipo porque no son de nadie: son prácticas. Ponerles el de alguien sería
// falso, así que se distinguen por estilo y van agrupadas aparte.
const LOGOS_ITEM: Record<string, string> = {
  Playwright: 'playwright',
  TypeScript: 'typescript',
  JavaScript: 'javascript',
  Selenium: 'selenium',
  Cypress: 'cypress',
  Appium: 'appium',
  'Cucumber / BDD': 'cucumber',
  Gherkin: 'cucumber',
  'OWASP ZAP': 'owasp',
  Postman: 'postman',
  k6: 'k6',
  JMeter: 'apachejmeter',
  Gatling: 'gatling',
  SonarQube: 'sonarqube',
  Jenkins: 'jenkins',
  'GitLab CI': 'gitlab',
  'Azure DevOps': 'azuredevops',
  Docker: 'docker',
  'Kubernetes / AKS': 'kubernetes',
  Terraform: 'terraform',
  AWS: 'amazonaws',
  Azure: 'microsoftazure',
  Git: 'git',
  GPT: 'openai',
  Claude: 'anthropic',
  Gemini: 'googlegemini',
  Copilot: 'githubcopilot',
  Java: 'openjdk',
  Python: 'python',
  'C#': 'csharp',
  // Nombres tal y como aparecen en el stack de cada etapa.
  Cucumber: 'cucumber',
  Kubernetes: 'kubernetes',
  Grafana: 'grafana',
  Prometheus: 'prometheus',
  Ansible: 'ansible',
  PostgreSQL: 'postgresql',
  MySQL: 'mysql',
  JIRA: 'jira',
  JUnit: 'junit5',
  Spring: 'spring',
  'Spring Boot': 'springboot',
  TestRail: 'testrail',
  'IA aplicada': 'anthropic',
};

/** Las capas posibles, en el orden en que se recorren las pruebas. */
const CAPAS = [
  'Web',
  'Escritorio',
  'Móvil',
  'API',
  'Datos',
  'Rendimiento',
  'Seguridad',
  'CI/CD',
  'Infraestructura',
  'Desarrollo',
];

const marcaDe = (item: string) => {
  const slug = LOGOS_ITEM[item];
  return slug ? svgs[`../herramientas/${slug}.svg`] : null;
};

// Un trazo por competencia. Rotula cada bloque de la rejilla para que se
// distingan de un vistazo sin tener que leer los ocho titulares.
const ICONOS_COMPETENCIA: Record<string, string> = {
  'Automatización': 'M9 3.2h6 M12 3.2v3 M5 6.2h14v11.6H5z M9.2 10.8h.01 M14.8 10.8h.01 M9.3 14.6h5.4 M2.5 10.5v4 M21.5 10.5v4',
  'APIs e integración': 'M8.5 3.5H7.5A2.5 2.5 0 0 0 5 6v3a2.5 2.5 0 0 1-2.5 2.5A2.5 2.5 0 0 1 5 14v3a2.5 2.5 0 0 0 2.5 2.5h1 M15.5 3.5h1A2.5 2.5 0 0 1 19 6v3a2.5 2.5 0 0 0 2.5 2.5A2.5 2.5 0 0 0 19 14v3a2.5 2.5 0 0 1-2.5 2.5h-1',
  'Rendimiento y seguridad': 'M3.5 18.5a8.75 8.75 0 1 1 17 0 M12 14.5l4.4-4.6 M12 18.5h.01',
  'CI/CD y plataformas': 'M6.6 15.6a3.6 3.6 0 1 1 0-7.2c3.4 0 4 7.2 7.4 7.2a3.6 3.6 0 1 0 0-7.2c-3.4 0-4 7.2-7.4 7.2Z',
  'IA aplicada al testing': 'M9 3v2 M15 3v2 M9 19v2 M15 19v2 M3 9h2 M3 15h2 M19 9h2 M19 15h2 M6 6h12v12H6z M10 10h4v4h-4z',
  'Liderazgo y estrategia': 'M9.2 11.2a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8Z M2.6 20a6.6 6.6 0 0 1 13.2 0 M16.8 5.4a3 3 0 0 1 0 6 M17.4 14.3a5.6 5.6 0 0 1 4 5.7',
  'Lenguajes': 'm8 8-4 4 4 4 M16 8l4 4-4 4 M14 4.5l-4 15',
  'Metodologías': 'M4 4.5h16v15H4z M9.4 4.5v15 M14.8 4.5v15 M6 8h1.6 M11.2 8h1.6 M16.6 8h1.6',
};

const ICONOS_AGENTE: Record<string, string> = {
  panel: 'M3 5h18v14H3z M3 9h18 M7 13h5 M7 16h8',
  auditoria: 'M9 3h6v3H9z M9 4.5H6.5A1.5 1.5 0 0 0 5 6v14a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 20V6a1.5 1.5 0 0 0-1.5-1.5H15 M9 13.5l2 2 4-4',
  ejecucion: 'M3 12h3.5L9 6.5l3.5 11L15 12h6',
  generador: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M12 12v5 M9.5 14.5h5',
  lupa: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z M16.2 16.2 21 21 M8.5 11h5 M8.5 8h5',
  datos: 'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3Z M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6 M20 12c0 1.7-3.6 3-8 3s-8-1.3-8-3',
  rendimiento: 'M3.5 18a9 9 0 1 1 17 0 M12 14l4.5-4.5 M12 18h.01',
  bug: 'M8.5 7a3.5 3.5 0 1 1 7 0 M6 10h12v4.5a6 6 0 0 1-12 0z M3 12.5h3 M18 12.5h3 M4.8 6.5 7.2 8 M19.2 6.5 16.8 8 M4.8 18.5 7.2 17 M19.2 18.5 16.8 17',
};
---

<Layout
  title={`Trayectoria — ${profile.nombreCompleto}`}
  description={`Trayectoria profesional de ${profile.nombreCompleto} en QA, automatización de pruebas y liderazgo de equipos de calidad.`}
>
  <!-- ============ ENCABEZADO CON FOTO ============ -->
  <section class="perfil relative flex flex-col overflow-hidden pt-[4.5rem] min-h-dvh sm:pt-20 lg:pt-24">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <div class="blob -z-10 right-[-4rem] top-16 h-80 w-80" style="background: var(--color-amber)"></div>

    {/* En móvil la foto va al lado del nombre, no encima: apilada empujaba
        todo lo demás fuera de la primera pantalla. */}
    <div class="mx-auto flex w-full max-w-[94rem] flex-1 items-center px-5 py-2 md:px-8 md:py-6">
      <div class="grid w-full items-center justify-center gap-4 sm:gap-10 lg:grid-cols-[auto_minmax(0,58rem)] lg:gap-16">
      <div class="reveal mx-auto lg:mx-0">
        <div class="relative grid place-items-center">
          {/* Halo difuso detrás del recorte: sin él la foto sin fondo queda
              flotando y se nota que está pegada encima de la página. */}
          <span
            class="pointer-events-none absolute h-[86%] w-[86%] rounded-full bg-[radial-gradient(circle,var(--color-fox-tint)_0%,var(--color-amber)_45%,transparent_72%)] opacity-70 blur-2xl"
          ></span>
          <img
            src="/girek-foto.png"
            srcset="/girek-foto-sm.png 360w, /girek-foto.png 720w"
            sizes="(max-width: 639px) 88px, (max-width: 1023px) 152px, 288px"
            alt="Giancarlo Renato Palomino Huallpa"
            width="720"
            height="720"
            class="foto-perfil relative h-[5.5rem] w-[5.5rem] object-contain sm:h-[9.5rem] sm:w-[9.5rem] lg:h-[28rem] lg:w-[28rem]"
          />
        </div>
      </div>

      <div class="min-w-0">
        <p class="reveal eyebrow">Trayectoria</p>
        <h1 class="reveal mt-1.5 font-display text-[clamp(1.5rem,4.4vw+0.9rem,5.2rem)] leading-[1.05] tracking-tight sm:mt-3" data-delay="60ms">
          {profile.nombreCompleto}
        </h1>
        <p class="reveal mt-2.5 text-[0.88rem] leading-[1.4] text-[var(--color-ink-soft)] sm:mt-6 sm:text-lg sm:leading-relaxed md:text-[1.35rem]" data-delay="100ms">
          Diseño la infraestructura de calidad de productos donde fallar cuesta caro: frameworks que
          otro equipo pueda mantener, pruebas que corren en cada build y agentes de IA que absorben
          el trabajo repetitivo.<span class="hidden sm:inline"> Empecé escribiendo código y nunca lo
          solté.</span>
        </p>

        <p class="reveal mt-2.5 inline-flex items-center gap-2.5 font-mono text-sm text-[var(--color-ink-soft)] sm:mt-7 sm:text-base" data-delay="140ms">
          <img
            src="/paises/pe.png"
            alt="Bandera del Perú"
            width="24"
            height="16"
            loading="lazy"
            class="h-4 w-6 rounded-[2px] object-cover ring-1 ring-black/10"
          />
          Lima, Perú
        </p>

        {/* En móvil, rejilla de dos: con flex-wrap los cuatro caían 2+2 pero de
            anchos distintos, y el del correo se salía. */}
        <div
          class="acciones-perfil reveal mt-2.5 grid grid-cols-2 gap-1.5 sm:mt-7 sm:flex sm:flex-wrap sm:gap-3"
          data-delay="180ms"
        >
          {
            contacto.map((c) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener"
                class:list={[
                  'btn min-w-0 justify-center text-[0.95rem] !px-4 !py-2 sm:!px-5 sm:!py-3',
                  c.principal ? 'btn-primary' : 'btn-ghost',
                ]}
              >
                <span class="herramienta herramienta-sm shrink-0" aria-hidden="true" set:html={c.svg} />
                <span class="truncate">
                  {c.textoCorto ? (
                    <>
                      <span class="sm:hidden">{c.textoCorto}</span>
                      <span class="hidden sm:inline">{c.texto}</span>
                    </>
                  ) : (
                    c.texto
                  )}
                </span>
              </a>
            ))
          }
          {profile.links.cv && (
            <a href={profile.links.cv} target="_blank" rel="noopener" class="btn btn-ghost text-sm">
              CV en PDF
            </a>
          )}
        </div>

        </div>
      </div>
    </div>

    <!-- ============ CIFRAS ============ -->
    <div class="border-t border-[var(--color-line)] bg-[var(--color-surface)]">
      <dl class="mx-auto grid max-w-[94rem] grid-cols-2 gap-px overflow-hidden bg-[var(--color-line)] lg:grid-cols-4">
      {
        cifras.map((c, i) => (
          <div
            class="reveal group flex flex-wrap items-center gap-x-3 bg-[var(--color-surface)] px-4 py-2 transition-colors duration-300 hover:bg-[var(--color-cream-2)] sm:px-6 sm:py-4 lg:block lg:px-8 lg:py-11"
            data-delay={`${i * 70}ms`}
          >
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-[var(--color-fox-tint)] text-[var(--color-fox-dark)] transition-transform duration-300 group-hover:-translate-y-0.5 sm:h-10 sm:w-10 lg:h-12 lg:w-12 lg:rounded-xl">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONOS[c.icono]
                  .split(' M')
                  .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                  .join('')}
              />
            </span>

            <dt class="font-display text-[1.9rem] leading-none tracking-tight text-[var(--color-fox-dark)] sm:text-[2.4rem] lg:mt-5 lg:text-[3rem]">
              {c.valor}
            </dt>
            <dd class="mt-1.5 w-full lg:mt-2">
              <span class="block text-[0.85rem] font-semibold leading-snug text-[var(--color-ink)] sm:text-base">{c.etiqueta}</span>
              {/* El matiz sobra en la primera pantalla de un móvil: lo que hay
                  que ver ahí es la cifra y de qué es. */}
              <span class="mt-1 hidden text-sm leading-snug text-[var(--color-ink-soft)] sm:block">{c.detalle}</span>
              {'banderas' in c && (
                <span class="mt-2.5 flex flex-wrap items-center gap-1.5">
                  {c.banderas.map((b) => (
                    <img
                      src={`/paises/${b.codigo}.png`}
                      alt={`Bandera de ${b.nombre}`}
                      title={b.nombre}
                      width="22"
                      height="15"
                      loading="lazy"
                      class="h-[15px] w-[22px] rounded-[2px] object-cover ring-1 ring-black/10"
                    />
                  ))}
                </span>
              )}
            </dd>
          </div>
        ))
      }
      </dl>
    </div>
  </section>

  <!-- ============ CONTENIDO CON FICHA FIJA ============ -->
  <div class="relative pt-12 md:pt-16">
    {/* El fondo se recorta en su propia capa: un overflow-hidden aquí
        convertiría a este div en el contenedor de desplazamiento y
        `position: sticky` dejaría de funcionar. */}
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="grid-bg absolute inset-0"></div>
    </div>

    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid gap-10 lg:grid-cols-[17rem_1fr] lg:gap-14 xl:grid-cols-[19rem_1fr]">
        {/* Ficha compacta que acompaña la lectura. Solo desde lg: en pantallas
            estrechas robaría el espacio de lectura, y arriba ya está el
            encabezado completo. */}
        <aside id="ficha" class="ficha hidden lg:sticky lg:top-[6.5rem] lg:block lg:h-[calc(100dvh-9rem)] lg:self-start">
          <div class="ficha-cuerpo flex h-full flex-col rounded-3xl border border-[var(--color-line)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-soft)]">
            <div class="flex items-center gap-4">
              <div class="relative shrink-0">
                <span
                  class="pointer-events-none absolute -inset-1 -z-10 rounded-full bg-[radial-gradient(circle,var(--color-fox-tint)_0%,var(--color-amber)_50%,transparent_74%)] opacity-60 blur-lg"
                ></span>
                <img
                  src="/girek-foto-sm.png"
                  alt=""
                  width="360"
                  height="360"
                  loading="lazy"
                  class="foto-perfil h-20 w-20 object-contain"
                />
              </div>
              <div class="min-w-0">
                <h2 class="font-display text-lg leading-tight tracking-tight">{profile.nombre}</h2>
                <p class="mt-1 flex items-center gap-1.5 font-mono text-[0.7rem] text-[var(--color-ink-soft)]">
                  <img
                    src="/paises/pe.png"
                    alt="Bandera del Perú"
                    width="16"
                    height="11"
                    loading="lazy"
                    class="h-[11px] w-4 rounded-[1px] object-cover ring-1 ring-black/10"
                  />
                  Lima, Perú
                </p>
              </div>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-2">
              {
                contacto.map((c) => (
                  <a
                    href={c.href}
                    target="_blank"
                    rel="noopener"
                    title={c.texto}
                    class:list={[
                      'btn w-full justify-center !gap-1.5 !px-2 !py-2 text-xs',
                      c.principal ? 'btn-primary' : 'btn-ghost',
                    ]}
                  >
                    <span class="herramienta herramienta-sm" aria-hidden="true" set:html={c.svg} />
                    {c.slug === 'gmail' ? 'Correo' : c.texto}
                  </a>
                ))
              }
            </div>

            <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-4 border-t border-[var(--color-line)] pt-5">
              {
                cifras.map((c) => (
                  <div class="flex flex-col">
                    <dt class="font-display text-xl leading-none text-[var(--color-fox-dark)]">{c.valor}</dt>
                    <dd class="mt-1.5 min-h-[2.4em] text-[0.7rem] leading-snug text-[var(--color-ink-soft)]">
                      {c.etiqueta}
                    </dd>
                  </div>
                ))
              }
            </dl>

            {/* Índice de la página. En una trayectoria de quince pantallas es lo
                que evita que el lector tenga que recorrerla entera para volver a
                un bloque. Se resalta el que está en pantalla. */}
            <nav class="mt-5 flex flex-1 flex-col border-t border-[var(--color-line)] pt-5" aria-label="Secciones de la página">
              <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">
                En esta página
              </p>
              <ul class="mt-3 flex flex-1 flex-col justify-between">
                {
                  [
                    { id: 'presentacion', texto: 'Presentación' },
                    { id: 'resultados', texto: 'Resultados' },
                    { id: 'clientes', texto: 'Clientes' },
                    { id: 'ia', texto: 'IA aplicada' },
                    { id: 'competencias', texto: 'Competencias' },
                    { id: 'recorrido', texto: 'Recorrido' },
                    { id: 'formacion', texto: 'Formación' },
                  ].map((s) => (
                    <li>
                      <a
                        href={`#${s.id}`}
                        data-indice={s.id}
                        class="indice-enlace flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm text-[var(--color-ink-soft)] transition-colors hover:bg-[var(--color-cream-2)] hover:text-[var(--color-ink)]"
                      >
                        <svg
                          class="indice-marca h-[15px] w-[15px] shrink-0 text-[var(--color-faint)] transition-colors"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.9"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          set:html={ICONOS_INDICE[s.id]
                            .split(' M')
                            .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                            .join('')}
                        />
                        {s.texto}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </aside>

        <div class="min-w-0">
  <!-- ============ PRESENTACIÓN ============ -->
