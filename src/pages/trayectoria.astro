                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={l.icono
                      .split(' M')
                      .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                      .join('')}
                  />
