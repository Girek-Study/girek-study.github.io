                {l.sector}
              </span>
            </div>

            <h3 class="mt-4 font-semibold leading-snug">{l.titulo}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-soft)]">{l.detalle}</p>

            {l.barra && (
              /* La misma métrica antes y después, en proporción. Un número
                 solo se cree; verlo comparado se entiende. */
              <div class="mt-4 space-y-2 border-t border-[var(--color-line)] pt-3.5">
                <div class="flex items-center gap-3">
                  <span class="w-16 shrink-0 font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-faint)]">
                    {l.barra.etiquetaAntes}
                  </span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-[var(--color-cream-2)]">
                    <span class="block h-full rounded-full bg-[var(--color-line-strong)]" style={`width:${l.barra.antes}%`} />
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-16 shrink-0 font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-fox-dark)]">
                    {l.barra.etiquetaDespues}
                  </span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-[var(--color-cream-2)]">
                    <span
                      class="block h-full rounded-full bg-gradient-to-r from-[var(--color-fox)] to-[var(--color-fox-dark)]"
                      style={`width:${l.barra.despues}%`}
                    />
                  </span>
                </div>
              </div>
            )}

            {l.puntos && (
              /* Sin este remate la tarjeta quedaba más corta que las de al lado
                 y la fila se descuadraba. Además, quince puntos se leen antes
                 que el número. */
              <div class="mt-4 border-t border-[var(--color-line)] pt-3.5">
                <p class="font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-faint)]">
                  {l.puntos.etiqueta}
                </p>
                <div class="mt-2.5 flex flex-wrap gap-1.5">
                  {Array.from({ length: l.puntos.cantidad }).map(() => (
                    <span class="h-2.5 w-2.5 rounded-full bg-gradient-to-br from-[var(--color-fox)] to-[var(--color-fox-dark)]" />
                  ))}
                </div>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ CLIENTES ============ -->
  <section id="clientes" class="sector">
    <SectionHeading
      eyebrow="Dónde"
      title="Productos que pasaron por mis manos"
      subtitle="Pulsa cualquier logotipo para ver desde qué empresa trabajé para ese cliente y qué se hizo ahí."
      ancho="max-w-4xl"
    />
    {/* Contadores calculados de la propia lista: si mañana se suma un cliente,
        las cifras se actualizan solas y nunca se contradicen con la rejilla. */}
    <div class="reveal mt-8 rounded-3xl border border-[var(--color-line)] bg-[var(--color-surface)] px-7 py-6 shadow-[var(--shadow-soft)] md:px-9 md:py-7">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-b border-[var(--color-line)] pb-5 sm:grid-cols-4">
        {
          metricasClientes.map((m, i) => (
            <div class:list={['flex items-baseline gap-2.5', i > 0 && 'sm:border-l sm:border-[var(--color-line)] sm:pl-6']}>
              <dt class="font-display text-[1.9rem] leading-none text-[var(--color-fox-dark)]">{m.valor}</dt>
              <dd class="max-w-[8rem] text-[0.8rem] leading-tight text-[var(--color-ink-soft)]">{m.etiqueta}</dd>
            </div>
          ))
        }
      </dl>

      {/* Muro de logotipos. Sin una caja por cliente: diecinueve recuadros
          dentro de otro competían entre sí. En gris para que ninguno domine, y a
          color al pasar el cursor. Al pulsar se abre el detalle. */}
        <div class="mt-7">
        <ul class="grid grid-cols-3 gap-x-8 gap-y-8 sm:grid-cols-4 lg:grid-cols-5">
          {
            clientes.map((c) => (
              <li>
                <button
                  type="button"
                  class="marca group flex w-full flex-col items-center gap-2.5"
                  data-cliente={c.nombre}
                  aria-haspopup="dialog"
                >
                  {/* Altura según el tipo de logo: un isotipo cuadrado necesita
                      más que un logotipo largo para pesar lo mismo. Sin esto
                      unos se ven diminutos junto a otros. */}
                  <span class="grid h-14 w-full place-items-center">
                    {c.logo ? (
                      <img
                        src={`/logos/${c.logo}`}
                        alt={`Logo de ${c.nombre}`}
                        width="150"
                        height="56"
                        loading="lazy"
                        class:list={[
                          'w-auto max-w-full object-contain sm:max-w-[9rem]',
                          c.iso ? 'max-h-[3.25rem]' : 'max-h-8',
                        ]}
                      />
