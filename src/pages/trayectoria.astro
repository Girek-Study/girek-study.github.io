---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../data/site';
import { experiencias, certificaciones, educacion, idiomas } from '../data/experience';
import {
  cifras,
  competencias,
  logrosDestacados,
  clientesPorSector,
  NOMBRE_PAIS,
  agentesIA,
  iaEnElCiclo,
} from '../data/perfil-extra';

// Los iconos se inlinean para poder teñirlos con el color del texto.
const svgs = import.meta.glob<string>('../herramientas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const modelos = [
  { slug: 'anthropic', nombre: 'Claude (Anthropic)' },
  { slug: 'openai', nombre: 'GPT (OpenAI)' },
  { slug: 'googlegemini', nombre: 'Gemini (Google)' },
  { slug: 'cursor', nombre: 'Cursor' },
  { slug: 'githubcopilot', nombre: 'GitHub Copilot' },
].map((m) => ({ ...m, svg: svgs[`../herramientas/${m.slug}.svg`] }));

const contacto = [
  { slug: 'whatsapp', texto: 'Escríbeme', href: profile.whatsappUrl, principal: true },
  { slug: 'linkedin', texto: 'LinkedIn', href: profile.links.linkedin, principal: false },
  { slug: 'github', texto: 'GitHub', href: profile.links.github, principal: false },
  { slug: 'gmail', texto: profile.email, href: `mailto:${profile.email}`, principal: false },
].map((c) => ({ ...c, svg: svgs[`../herramientas/${c.slug}.svg`] }));

// Nueve entran en una fila del ancho de la columna; con diez, la última
// caía sola a un segundo renglón.
// Trazos de los iconos del índice lateral.
const ICONOS_INDICE: Record<string, string> = {
  presentacion: 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
  resultados: 'M3 17l6-6 4 4 8-8 M21 7v5h-5',
  clientes: 'M3 21h18 M6 21V8l6-4 6 4v13 M10 21v-5h4v5',
  ia: 'M9 3v2 M15 3v2 M9 19v2 M15 19v2 M3 9h2 M3 15h2 M19 9h2 M19 15h2 M6 6h12v12H6z M10 10h4v4h-4z',
  competencias: 'm12 2 9 5-9 5-9-5 9-5Z M3 12l9 5 9-5 M3 17l9 5 9-5',
  recorrido: 'M12 7v5l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  formacion: 'm12 3 10 5-10 5L2 8l10-5Z M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5',
};

const herramientasDiarias = [
  'playwright', 'typescript', 'cucumber', 'k6', 'postman',
  'azuredevops', 'docker', 'jenkins', 'gitlab',
].map((slug) => svgs[`../herramientas/${slug}.svg`]);

// Trazos de los iconos de las cifras. Inline y no una librería: son cuatro.
const ICONOS: Record<string, string> = {
  reloj: 'M12 7v5l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  chip: 'M9 3v2 M15 3v2 M9 19v2 M15 19v2 M3 9h2 M3 15h2 M19 9h2 M19 15h2 M6 6h12v12H6z M10 10h4v4h-4z',
  grafico: 'M3 6l7 7 4-4 7 7 M21 16v4h-4',
  globo: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3.6 9h16.8 M3.6 15h16.8 M12 3a14 14 0 0 1 0 18 M12 3a14 14 0 0 0 0 18',
};
---

<Layout
  title={`Trayectoria — ${profile.nombreCompleto}`}
  description={`Trayectoria profesional de ${profile.nombreCompleto} en QA, automatización de pruebas y liderazgo de equipos de calidad.`}
>
  <!-- ============ ENCABEZADO CON FOTO ============ -->
  <section class="perfil relative flex flex-col overflow-hidden pt-28 lg:min-h-dvh lg:pt-24">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <div class="blob -z-10 right-[-4rem] top-16 h-80 w-80" style="background: var(--color-amber)"></div>

    <div class="mx-auto flex w-full max-w-[94rem] flex-1 items-center px-5 py-6 md:px-8">
      <div class="grid w-full items-center justify-center gap-10 lg:grid-cols-[auto_minmax(0,58rem)] lg:gap-16">
      <div class="reveal mx-auto lg:mx-0">
        <div class="relative grid place-items-center">
          {/* Halo difuso detrás del recorte: sin él la foto sin fondo queda
              flotando y se nota que está pegada encima de la página. */}
          <span
            class="pointer-events-none absolute h-[86%] w-[86%] rounded-full bg-[radial-gradient(circle,var(--color-fox-tint)_0%,var(--color-amber)_45%,transparent_72%)] opacity-70 blur-2xl"
          ></span>
          <img
            src="/girek-foto.png"
            srcset="/girek-foto-sm.png 360w, /girek-foto.png 720w"
            sizes="(max-width: 1023px) 208px, 288px"
            alt="Giancarlo Renato Palomino Huallpa"
            width="720"
            height="720"
            class="foto-perfil relative h-64 w-64 object-contain sm:h-80 sm:w-80 lg:h-[28rem] lg:w-[28rem]"
          />
        </div>
      </div>

      <div class="min-w-0">
        <p class="reveal eyebrow">Trayectoria</p>
        <h1 class="reveal mt-3 font-display text-[clamp(2.1rem,4.4vw+0.9rem,5.2rem)] leading-[1.03] tracking-tight" data-delay="60ms">
          {profile.nombreCompleto}
        </h1>
        <p class="reveal mt-6 text-lg leading-relaxed text-[var(--color-ink-soft)] md:text-[1.35rem]" data-delay="100ms">
          Diseño la infraestructura de calidad de productos donde fallar cuesta caro: frameworks que
          otro equipo pueda mantener, pruebas que corren en cada build y agentes de IA que absorben
          el trabajo repetitivo. Empecé escribiendo código y nunca lo solté.
        </p>

        <p class="reveal mt-7 inline-flex items-center gap-2.5 font-mono text-base text-[var(--color-ink-soft)]" data-delay="140ms">
          <img
            src="/paises/pe.png"
            alt="Bandera del Perú"
            width="24"
            height="16"
            loading="lazy"
            class="h-4 w-6 rounded-[2px] object-cover ring-1 ring-black/10"
          />
          Lima, Perú
        </p>

        <div class="acciones-perfil reveal mt-7 flex flex-wrap gap-3" data-delay="180ms">
          {
            contacto.map((c) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener"
                class:list={['btn text-[0.95rem] !px-5 !py-3', c.principal ? 'btn-primary' : 'btn-ghost']}
              >
                <span class="herramienta herramienta-sm" aria-hidden="true" set:html={c.svg} />
                {c.texto}
              </a>
            ))
          }
          {profile.links.cv && (
            <a href={profile.links.cv} target="_blank" rel="noopener" class="btn btn-ghost text-sm">
              CV en PDF
            </a>
          )}
        </div>

        </div>
      </div>
    </div>

    <!-- ============ CIFRAS ============ -->
    <div class="border-t border-[var(--color-line)] bg-[var(--color-surface)]">
      <dl class="mx-auto grid max-w-[94rem] grid-cols-1 gap-px overflow-hidden bg-[var(--color-line)] sm:grid-cols-2 lg:grid-cols-4">
      {
        cifras.map((c, i) => (
          <div
            class="reveal group bg-[var(--color-surface)] px-6 py-8 transition-colors duration-300 hover:bg-[var(--color-cream-2)] md:px-8 md:py-11"
            data-delay={`${i * 70}ms`}
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-[var(--color-fox-tint)] text-[var(--color-fox-dark)] transition-transform duration-300 group-hover:-translate-y-0.5">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONOS[c.icono]
                  .split(' M')
                  .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                  .join('')}
              />
            </span>

            <dt class="mt-5 font-display text-[3rem] leading-none tracking-tight text-[var(--color-fox-dark)]">
              {c.valor}
            </dt>
            <dd class="mt-2">
              <span class="block font-semibold leading-snug text-[var(--color-ink)]">{c.etiqueta}</span>
              <span class="mt-1 block text-sm leading-snug text-[var(--color-ink-soft)]">{c.detalle}</span>
              {'banderas' in c && (
                <span class="mt-2.5 flex flex-wrap items-center gap-1.5">
                  {c.banderas.map((b) => (
                    <img
                      src={`/paises/${b.codigo}.png`}
                      alt={`Bandera de ${b.nombre}`}
                      title={b.nombre}
                      width="22"
                      height="15"
                      loading="lazy"
                      class="h-[15px] w-[22px] rounded-[2px] object-cover ring-1 ring-black/10"
                    />
                  ))}
                </span>
              )}
            </dd>
          </div>
        ))
      }
      </dl>
    </div>
  </section>

  <!-- ============ CONTENIDO CON FICHA FIJA ============ -->
  <div class="relative pt-12 md:pt-16">
    {/* El fondo se recorta en su propia capa: un overflow-hidden aquí
        convertiría a este div en el contenedor de desplazamiento y
        `position: sticky` dejaría de funcionar. */}
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="grid-bg absolute inset-0"></div>
    </div>

    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid gap-10 lg:grid-cols-[17rem_1fr] lg:gap-14 xl:grid-cols-[19rem_1fr]">
        {/* Ficha compacta que acompaña la lectura. Solo desde lg: en pantallas
            estrechas robaría el espacio de lectura, y arriba ya está el
            encabezado completo. */}
        <aside id="ficha" class="ficha hidden lg:sticky lg:top-[6.5rem] lg:block lg:h-[calc(100dvh-9rem)] lg:self-start">
          <div class="ficha-cuerpo flex h-full flex-col rounded-3xl border border-[var(--color-line)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-soft)]">
            <div class="flex items-center gap-4">
              <div class="relative shrink-0">
                <span
                  class="pointer-events-none absolute -inset-1 -z-10 rounded-full bg-[radial-gradient(circle,var(--color-fox-tint)_0%,var(--color-amber)_50%,transparent_74%)] opacity-60 blur-lg"
                ></span>
                <img
                  src="/girek-foto-sm.png"
                  alt=""
                  width="360"
                  height="360"
                  loading="lazy"
                  class="foto-perfil h-20 w-20 object-contain"
                />
              </div>
              <div class="min-w-0">
                <h2 class="font-display text-lg leading-tight tracking-tight">{profile.nombre}</h2>
                <p class="mt-1 flex items-center gap-1.5 font-mono text-[0.7rem] text-[var(--color-ink-soft)]">
                  <img
                    src="/paises/pe.png"
                    alt="Bandera del Perú"
                    width="16"
                    height="11"
                    loading="lazy"
                    class="h-[11px] w-4 rounded-[1px] object-cover ring-1 ring-black/10"
                  />
                  Lima, Perú
                </p>
              </div>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-2">
              {
                contacto.map((c) => (
                  <a
                    href={c.href}
                    target="_blank"
                    rel="noopener"
                    title={c.texto}
                    class:list={[
                      'btn w-full justify-center !gap-1.5 !px-2 !py-2 text-xs',
                      c.principal ? 'btn-primary' : 'btn-ghost',
                    ]}
                  >
                    <span class="herramienta herramienta-sm" aria-hidden="true" set:html={c.svg} />
                    {c.slug === 'gmail' ? 'Correo' : c.texto}
                  </a>
                ))
              }
            </div>

            <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-4 border-t border-[var(--color-line)] pt-5">
              {
                cifras.map((c) => (
                  <div class="flex flex-col">
                    <dt class="font-display text-xl leading-none text-[var(--color-fox-dark)]">{c.valor}</dt>
                    <dd class="mt-1.5 min-h-[2.4em] text-[0.7rem] leading-snug text-[var(--color-ink-soft)]">
                      {c.etiqueta}
                    </dd>
                  </div>
                ))
              }
            </dl>

            {/* Índice de la página. En una trayectoria de quince pantallas es lo
                que evita que el lector tenga que recorrerla entera para volver a
                un bloque. Se resalta el que está en pantalla. */}
            <nav class="mt-5 flex flex-1 flex-col border-t border-[var(--color-line)] pt-5" aria-label="Secciones de la página">
              <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-[var(--color-faint)]">
                En esta página
              </p>
              <ul class="mt-3 flex flex-1 flex-col justify-between">
                {
                  [
                    { id: 'presentacion', texto: 'Presentación' },
                    { id: 'resultados', texto: 'Resultados' },
                    { id: 'clientes', texto: 'Clientes' },
                    { id: 'ia', texto: 'IA aplicada' },
                    { id: 'competencias', texto: 'Competencias' },
                    { id: 'recorrido', texto: 'Recorrido' },
                    { id: 'formacion', texto: 'Formación' },
                  ].map((s) => (
                    <li>
                      <a
                        href={`#${s.id}`}
                        data-indice={s.id}
                        class="indice-enlace flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm text-[var(--color-ink-soft)] transition-colors hover:bg-[var(--color-cream-2)] hover:text-[var(--color-ink)]"
                      >
                        <svg
                          class="indice-marca h-[15px] w-[15px] shrink-0 text-[var(--color-faint)] transition-colors"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.9"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          set:html={ICONOS_INDICE[s.id]
                            .split(' M')
                            .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                            .join('')}
                        />
                        {s.texto}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </aside>

        <div class="min-w-0">
  <!-- ============ PRESENTACIÓN ============ -->
  <section id="presentacion" class="sector">
    <SectionHeading
      eyebrow="Presentación"
      title="Cómo trabajo"
      subtitle="Diez años, cuatro países y una forma de trabajar que no depende de la herramienta de turno."
      ancho="max-w-4xl"
    />

    <div class="mt-6 grid gap-7 lg:grid-cols-[1.18fr_1fr] lg:gap-10">
      <div class="reveal">
        <p class="border-l-2 border-[var(--color-fox)] pl-5 font-display text-2xl leading-snug tracking-tight text-[var(--color-ink)] md:text-[1.6rem]">
          Empecé escribiendo código y nunca lo solté. Por eso discuto un pipeline o un contrato de API
          con desarrollo de igual a igual.
        </p>

        <p class="texto-justo mt-5 leading-relaxed text-[var(--color-ink-soft)]">
          Empecé programando en Java y terminé liderando chapters de calidad en banca y fintech. En el
          camino aprendí que una suite no vale por cuántas pruebas tiene, sino por cuántas siguen
          corriendo dos años después sin que nadie las pelee.
        </p>

        <p class="texto-justo mt-4 leading-relaxed text-[var(--color-ink-soft)]">
          Hoy construyo frameworks que otro equipo pueda mantener, llevo las pruebas al pipeline para
          que el feedback llegue en minutos y no en días, y aplico IA al diseño y al análisis sin
          soltarle el volante.
        </p>

        <div class="reveal mt-7 border-t border-[var(--color-line)] pt-4" data-delay="240ms">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-faint)]">
            Con lo que construyo a diario
          </p>
          <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
            {
              herramientasDiarias.map((h) => (
                <li
                  class="herramienta text-[var(--color-ink-soft)] transition-colors duration-200 hover:text-[var(--color-fox-dark)]"
                  aria-hidden="true"
                  set:html={h}
                />
              ))
            }
          </ul>
        </div>
      </div>

      <div>
        <p class="reveal eyebrow" data-delay="60ms">Tres decisiones que tomo en todo proyecto</p>

        <ul class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-1">
        {
          [
            {
              icono: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75',
              titulo: 'Construyo para que lo mantenga el equipo',
              texto:
                'Si para tocar una prueba hay que preguntarme, el diseño falló. Nombres de negocio, capas separadas y decisiones explicadas.',
            },
            {
              icono: 'M6 3v12 M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6 M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6 M18 9a9 9 0 0 1-9 9',
              titulo: 'Lo que no está en el pipeline no existe',
              texto:
                'Una prueba que alguien tiene que acordarse de ejecutar no protege nada. Corre en cada build o no cuenta.',
            },
            {
              icono: 'M11 3l1.8 4.4L17 9l-4.2 1.6L11 15l-1.8-4.4L5 9l4.2-1.6Z M18 14l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9Z',
              titulo: 'La IA propone, la decisión es humana',
              texto:
                'Ningún modelo sabe si una diferencia es el cambio acordado o el defecto. Esa clasificación es donde está el criterio.',
            },
          ].map((pilar, i) => (
            <li class="reveal card flex gap-4 p-4" data-delay={`${i * 80}ms`}>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[var(--color-fox-tint)] text-[var(--color-fox-dark)]">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={pilar.icono
                    .split(' M')
                    .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                    .join('')}
                />
              </span>
              <div>
                <h3 class="font-semibold leading-snug">{pilar.titulo}</h3>
                <p class="mt-1.5 text-[0.85rem] leading-relaxed text-[var(--color-ink-soft)]">{pilar.texto}</p>
              </div>
            </li>
          ))
        }
        </ul>
      </div>
    </div>

  </section>

  <!-- ============ LOGROS DESTACADOS ============ -->
  <section id="resultados" class="sector">
    <SectionHeading
      eyebrow="Resultados"
      title="Lo que se movió cuando estuve"
      subtitle="Cifras del CV, cada una con el contexto en el que ocurrió."
    />
    <div class="mt-7 grid gap-4 sm:grid-cols-2">
      {
        logrosDestacados.map((l, i) => (
          <article class="reveal card card-hover flex flex-col p-5" data-delay={`${i * 70}ms`}>
            {/* Icono y cifra en la misma línea: separados, el icono quedaba
                suelto en su propio renglón y la tarjeta perdía compacidad. */}
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--color-fox-tint)] text-[var(--color-fox-dark)]">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={l.icono
                      .split(' M')
                      .map((d, n) => `<path d="${n === 0 ? d : 'M' + d}"/>`)
                      .join('')}
                  />
                </span>
                <p class="font-display text-[2.3rem] leading-none text-[var(--color-fox-dark)]">{l.cifra}</p>
              </div>

              <span class="shrink-0 rounded-full border border-[var(--color-line)] px-3 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-faint)]">
                {l.sector}
              </span>
            </div>

            <h3 class="mt-4 font-semibold leading-snug">{l.titulo}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-soft)]">{l.detalle}</p>

            {l.barra && (
              /* La misma métrica antes y después, en proporción. Un número
                 solo se cree; verlo comparado se entiende. */
              <div class="mt-4 space-y-2 border-t border-[var(--color-line)] pt-3.5">
                <div class="flex items-center gap-3">
                  <span class="w-16 shrink-0 font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-faint)]">
                    {l.barra.etiquetaAntes}
                  </span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-[var(--color-cream-2)]">
                    <span class="block h-full rounded-full bg-[var(--color-line-strong)]" style={`width:${l.barra.antes}%`} />
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-16 shrink-0 font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-fox-dark)]">
                    {l.barra.etiquetaDespues}
                  </span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-[var(--color-cream-2)]">
                    <span
                      class="block h-full rounded-full bg-gradient-to-r from-[var(--color-fox)] to-[var(--color-fox-dark)]"
                      style={`width:${l.barra.despues}%`}
                    />
                  </span>
                </div>
              </div>
            )}

            {l.puntos && (
              /* Sin este remate la tarjeta quedaba más corta que las de al lado
                 y la fila se descuadraba. Además, quince puntos se leen antes
                 que el número. */
              <div class="mt-4 border-t border-[var(--color-line)] pt-3.5">
                <p class="font-mono text-[0.65rem] uppercase tracking-wide text-[var(--color-faint)]">
                  {l.puntos.etiqueta}
                </p>
                <div class="mt-2.5 flex flex-wrap gap-1.5">
                  {Array.from({ length: l.puntos.cantidad }).map(() => (
                    <span class="h-2.5 w-2.5 rounded-full bg-gradient-to-br from-[var(--color-fox)] to-[var(--color-fox-dark)]" />
                  ))}
                </div>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

