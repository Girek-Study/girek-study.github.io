  <!-- ============ LOGROS DESTACADOS ============ -->
  <section id="resultados" class="sector">
    <SectionHeading
      eyebrow="Resultados"
      title="Lo que se movió cuando estuve"
      subtitle="Cifras del CV, cada una con el contexto en el que ocurrió."
    />
    <div class="mt-7 grid gap-4 sm:grid-cols-2">
      {
        logrosDestacados.map((l, i) => (
          <article class="reveal card card-hover flex flex-col p-5" data-delay={`${i * 70}ms`}>
            {/* Icono y cifra en la misma línea: separados, el icono quedaba
                suelto en su propio renglón y la tarjeta perdía compacidad. */}
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <div class="flex items-center gap-3">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--color-fox-tint)] text-[var(--color-fox-dark)]">
