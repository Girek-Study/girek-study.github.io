                      <span class="font-display text-2xl text-[var(--color-ink-soft)]">{c.nombre.slice(0, 3)}</span>
                    )}
                  </span>

                  <span class="text-[0.72rem] text-[var(--color-faint)] transition-colors group-hover:text-[var(--color-fox-dark)]">
                    {c.nombre}
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* Detalle del cliente. Uno solo, que se rellena al pulsar: diecinueve
        diálogos en el HTML pesarían sin que nadie los llegue a abrir. */}
    <dialog
      id="dialogo-cliente"
      class="dialogo-cliente m-auto w-[min(38rem,92vw)] overflow-hidden rounded-[28px] border border-[var(--color-line)] bg-[var(--color-surface)] p-0 shadow-[0_40px_90px_-30px_rgba(29,23,18,0.45)] backdrop:bg-[rgba(29,23,18,0.5)] backdrop:backdrop-blur-sm"
    >
      <header class="relative border-b border-[var(--color-line)] bg-gradient-to-br from-[var(--color-cream-2)] to-[var(--color-cream)] px-7 py-6 md:px-8">
