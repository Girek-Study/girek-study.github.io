---
import Layout from '../layouts/Layout.astro';
import { profile, stats, stack } from '../data/site';
import { proyectos } from '../data/projects';
import { girekStudy } from '../data/courses';
import { obtenerRepos } from '../data/github';
import { getCollection } from 'astro:content';
import { formatearFecha, minutosDeLectura } from '../utils/fechas';

// Los iconos se inlinean para poder teñirlos con `currentColor`. Con <img> no
// se puede: quedarían en su color de marca y la fila se vería como un collage.
const svgs = import.meta.glob<string>('../herramientas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const herramientas = [
  'playwright', 'typescript', 'cypress', 'selenium', 'appium',
  'cucumber', 'k6', 'postman', 'azuredevops', 'docker',
].map((slug) => ({
  slug,
  nombre: slug === 'azuredevops' ? 'Azure DevOps' : slug,
  svg: svgs[`../herramientas/${slug}.svg`],
}));

// Nombre visible -> archivo de icono. Lo que no tiene icono va solo con texto:
// preferible a inventar un logo que no es el de la herramienta.
const ICONOS: Record<string, string> = {
  Playwright: 'playwright',
  TypeScript: 'typescript',
  Selenium: 'selenium',
  Cypress: 'cypress',
  Appium: 'appium',
  'Cucumber / BDD': 'cucumber',
  Postman: 'postman',
  k6: 'k6',
  JMeter: 'apachejmeter',
  'Azure DevOps': 'azuredevops',
  Jenkins: 'jenkins',
  'GitLab CI': 'gitlab',
  Docker: 'docker',
  Kubernetes: 'kubernetes',
  SQL: 'postgresql',
  Java: 'openjdk',
  Python: 'python',
};

// Estas tres no existen como icono monocromo, así que van como imagen desde
// su propia fuente oficial. Se sirven de public/herramientas/.
const IMAGENES: Record<string, string> = {
  Screenplay: 'serenity.png',
  RestAssured: 'restassured.png',
  Karate: 'karate.png',
};

const marquee = [...stack, ...stack].map((nombre) => ({
  nombre,
  svg: ICONOS[nombre] ? svgs[`../herramientas/${ICONOS[nombre]}.svg`] : null,
  imagen: IMAGENES[nombre] ? `/herramientas/${IMAGENES[nombre]}` : null,
}));

const destacados = proyectos.filter((p) => p.destacado).slice(0, 3);

// Los repositorios se cuentan en vivo; las notas, desde la colección. Así los
// contadores de la bienvenida nunca mienten sobre lo que hay publicado.
const repos = await obtenerRepos();
const notas = (await getCollection('notas', ({ data }) => import.meta.env.DEV || !data.borrador)).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const ultimasNotas = notas.slice(0, 3);

const plural = (n: number, singular: string, plural_: string) =>
  `${n} ${n === 1 ? singular : plural_}`;

const entradas = [
  {
    etiqueta: 'Código',
    contador: `${plural(repos.length, 'repositorio', 'repositorios')} abierto`,
    listo: true,
    titulo: 'Frameworks que puedes clonar',
    texto:
      'Implementaciones completas y funcionando, con su CI en verde. No fragmentos de tutorial: el esqueleto que uso para arrancar una suite de verdad.',
    accion: 'Ver el código',
    href: '/portafolio',
    trazo: 'm8.4 8.2-4.6 3.8 4.6 3.8 M15.6 8.2l4.6 3.8-4.6 3.8 M13.6 4.6l-3.2 14.8',
  },
  {
    etiqueta: 'Escritura',
    contador: `${plural(notas.length, 'nota publicada', 'notas publicadas')}`,
    listo: true,
    titulo: 'Decisiones y errores caros',
    texto:
      'Por qué una suite se vuelve inmantenible, cuándo un patrón no vale la pena y qué se rompe en producción sin que la interfaz muestre nada.',
    accion: 'Leer las notas',
    href: '/notas',
    trazo:
      'M14 3.5H7.5A2 2 0 0 0 5.5 5.5v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8.2z M14 3.5v4.7h4.5 M8.6 12.6h6.8 M8.6 16h4.6',
  },
  {
    etiqueta: 'Enseñanza',
    contador: 'En preparación',
    listo: false,
    titulo: 'Clases en vivo',
    texto:
      'Rutas guiadas de automatización, de los fundamentos a un framework listo para producción. Todavía no abren; el material abierto ya está aquí.',
    accion: 'Ver el temario',
    href: '/girek-study',
    trazo:
      'm12 3.4 9.2 4.4-9.2 4.4-9.2-4.4 9.2-4.4Z M5.6 10.1v5c0 1.7 2.9 3 6.4 3s6.4-1.3 6.4-3v-5 M21.2 7.8v6',
  },
];
---

<Layout>
  <!-- ============ HERO ============ -->
  <section class="seccion hero relative flex flex-col overflow-hidden pt-24 lg:pt-20">
    <!-- Fondo con vida -->
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <div class="blob -z-10 left-[-6rem] top-10 h-72 w-72" style="background: var(--color-amber)"></div>
    <div class="blob -z-10 right-[-4rem] top-40 h-80 w-80" style="background: var(--color-coral); animation-delay: -6s"></div>

    <div class="mx-auto flex w-full max-w-6xl flex-1 items-center px-5 md:px-8">
      <div class="grid w-full items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <img
            src="/brand/girek-fox-full.png"
            alt=""
            width="288"
            height="226"
            class="reveal float mb-3 ml-auto w-24 drop-shadow-[0_16px_32px_rgba(224,73,10,0.3)] sm:w-36 lg:hidden"
          />

          <p class="reveal eyebrow">Bienvenido a Girek Study</p>

          <h1
            class="reveal mt-5 font-display leading-[1.02] tracking-tight text-[clamp(2.05rem,4.6vw+0.6rem,4.4rem)]"
            data-delay="80ms"
          >
            La calidad no se repite.<br /><span class="text-gradient">Se programa.</span>
          </h1>

          <p
            class="reveal mt-5 max-w-xl leading-relaxed text-[var(--color-ink-soft)] text-[clamp(1rem,0.5vw+0.9rem,1.25rem)]"
            data-delay="160ms"
          >
            Probar no es seguir un guion paso a paso. Es escribir el código que recorre lo que ningún
            guion alcanzaría, y que lo vuelve a hacer en cada release sin cansarse.
          </p>

          <p
            class="cita reveal mt-6 max-w-xl border-l-2 border-[var(--color-fox)] pl-5 font-display text-lg leading-snug tracking-tight text-[var(--color-ink)] md:text-xl"
            data-delay="200ms"
          >
            Lo que no está en el pipeline no es una prueba: es una esperanza.
          </p>

          <div class="acciones reveal mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-delay="260ms">
            <a href="/portafolio" class="btn btn-primary justify-center">
              Ver el código
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/trayectoria" class="btn btn-ghost justify-center">Conoce a Girek</a>
          </div>

          <p class="credito reveal mt-5 font-mono text-xs leading-relaxed text-[var(--color-faint)]" data-delay="300ms">
            10 años de experiencia en QA · IA QE Automation Lead · ISTQB
          </p>

        </div>

        <!-- Visual: emblema zorro + tarjeta de código -->
        <div class="reveal relative mx-auto hidden w-full max-w-md self-start lg:block" data-delay="200ms">
          <div class="float relative z-10 mx-auto -mb-6 -mt-10 w-64 lg:mr-4 lg:ml-auto">
            <img src="/brand/girek-fox-full.png" alt="" width="288" height="226" class="w-full drop-shadow-[0_22px_45px_rgba(224,73,10,0.35)]" />
          </div>
          <div class="card overflow-hidden" aria-hidden="true">
            <div class="flex items-center gap-1.5 border-b border-[var(--color-line)] bg-[var(--color-cream-2)] px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
              <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
              <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
              <span class="ml-3 font-mono text-xs text-[var(--color-faint)]">tareas.spec.ts</span>
            </div>
            <pre class="overflow-x-auto p-5 font-mono text-[0.8rem] leading-relaxed text-[var(--color-ink-soft)]"><code><span class="text-[var(--color-fox-deep)]">test</span>(<span class="text-[var(--color-amber)]">'cuenta las pendientes'</span>, <span class="text-[var(--color-fox-deep)]">async</span> ({'{'} ana {'}'}) =&gt; {'{'}
  <span class="text-[var(--color-fox-deep)]">await</span> ana.intenta(
    IniciarSesion.comoUsuarioValido(),
    AgregarTarea.llamada(<span class="text-[var(--color-amber)]">'Revisar'</span>),
    Ensure.that(
      Text.de(Contador),
      igualA(<span class="text-[var(--color-amber)]">'1 pendiente'</span>),
    ),
  );
{'}'});

<span class="text-[var(--color-cyan-deep)]">✓</span> <span class="text-[var(--color-faint)]">1 passed (1.2s)</span></code></pre>
          </div>

          <!-- Herramientas con las que trabajo -->
          <div class="stack mt-8">
            <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-faint)]">
              El stack con el que construyo
            </p>
            <ul class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3">
              {
                herramientas.map((h) => (
                  <li
                    class="herramienta text-[var(--color-ink-soft)] transition-colors duration-200 hover:text-[var(--color-fox-deep)]"
                    set:html={h.svg}
                  />
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <a
      href="#que-hay-aqui"
      class="pista-scroll mx-auto mt-8 hidden items-center gap-2 font-mono text-xs text-[var(--color-faint)] transition-colors hover:text-[var(--color-fox-dark)] lg:inline-flex"
    >
      <span>Hay más abajo</span>
      <svg class="flecha-abajo" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M12 5v14M6 13l6 6 6-6" />
      </svg>
    </a>

    <!-- ============ MARQUEE DE STACK ============ -->
    <div class="marquee-fuera mt-6 border-t border-[var(--color-line)] bg-[var(--color-surface)] py-4">
      <div class="marquee-track overflow-hidden">
        <div class="marquee gap-3 pr-3">
          {
            marquee.map((m) => (
              <span class="flex shrink-0 items-center gap-2 rounded-full border border-[var(--color-line-strong)] bg-[var(--color-cream-2)] px-4 py-2 font-mono text-sm text-[var(--color-ink-soft)]">
                {m.svg ? (
                  <span class="herramienta herramienta-sm" aria-hidden="true" set:html={m.svg} />
                ) : m.imagen ? (
                  <img
                    src={m.imagen}
                    alt={`Logo de ${m.nombre}`}
                    width="17"
                    height="17"
                    loading="lazy"
                    class="h-[1.05rem] w-[1.05rem] object-contain"
                  />
                ) : (
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-cyan)]" />
                )}
                {m.nombre}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ QUÉ HAY AQUÍ ============ -->
  <section id="que-hay-aqui" class="seccion mx-auto max-w-6xl px-5 md:px-8">
    {/* El titular y el párrafo estaban apilados y centrados en una columna
        estrecha: un muro de texto con media pantalla vacía a los lados. Ahora
        comparten fila y el ancho se usa entero. */}
    <div class="cabecera-puertas">
      <div class="reveal">
        <p class="eyebrow">Qué vas a encontrar</p>
        <h2 class="mt-3.5 font-display text-3xl leading-[1.08] tracking-tight sm:text-4xl md:text-[2.7rem]">
          Lo que falta es lo de después
        </h2>
      </div>
      <p class="reveal texto-puertas" data-delay="90ms">
        Casi todo el buen material sobre automatización está en inglés, y lo que hay en español se queda
        en el «hola mundo»: instalar la herramienta, escribir un test, fin. Lo que falta es cómo se
        sostiene una suite de trescientas pruebas, por qué se vuelve inmantenible y qué decisiones evitan
        llegar ahí. Eso es lo que publico acá, con el código a la vista y el porqué de cada decisión.
      </p>
    </div>

    <div class="rejilla-puertas">
      {
        entradas.map((e, i) => (
          <a href={e.href} class="reveal card card-hover ficha-puerta group" data-delay={`${i * 90}ms`}>
            <span class="orden-puerta" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

            <span class="icono-puerta" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={e.trazo} />
              </svg>
            </span>

            <span class="etiqueta-puerta">{e.etiqueta}</span>
            <h3 class="titulo-puerta">{e.titulo}</h3>
            <p class="texto-puerta">{e.texto}</p>

            <span class="pie-puerta">
              {/* El estado dice si eso ya existe o todavía no: un enlace que
                  promete algo que no está listo se nota, y es peor no decirlo. */}
              <span class:list={['estado-puerta', !e.listo && 'es-pendiente']}>{e.contador}</span>
              <span class="accion-puerta">
                {e.accion}
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
                </svg>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ PROYECTOS DESTACADOS ============ -->
  <section class="seccion mx-auto max-w-6xl px-5 md:px-8">
    {/* Mismas fichas que el portafolio: el sector por delante de la categoría
        técnica y la cifra cuando existe. Quien llega desde aquí encuentra allí
        lo mismo, no otro diseño. */}
    <div class="reveal cabecera-bloque">
      <div>
        <p class="eyebrow">Portafolio</p>
        <h2 class="mt-3 font-display text-3xl leading-[1.08] tracking-tight sm:text-4xl md:text-[2.7rem]">
          Proyectos destacados
        </h2>
      </div>
      <div class="remate-bloque">
        <p class="nota-bloque">Una selección de trabajo en automatización, calidad y producto.</p>
        <a href="/portafolio" class="btn btn-ghost text-sm">
          Ver todos
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
          </svg>
        </a>
      </div>
    </div>

    <div class="rejilla-casos">
      {
        destacados.map((p, i) => (
          <a href="/portafolio" class="reveal card card-hover ficha-caso group" data-delay={`${i * 80}ms`}>
            <div class="cabeza-caso">
              <span class="sector-caso">{p.sector}</span>
              <span class="sello-destacado">{p.categoria}</span>
            </div>

            <h3 class="titulo-caso">{p.titulo}</h3>
            <p class="resumen-caso">{p.resumen}</p>

            {p.metrica && (
              <div class="metrica-caso">
                <span class="valor-metrica">{p.metrica.valor}</span>
                <span class="etiqueta-metrica">{p.metrica.etiqueta}</span>
              </div>
            )}

            <div class="pie-caso">
              <span class="temas-nota">
                {p.tags.slice(0, 4).map((tag) => (
                  <span class="tema-claro">{tag}</span>
                ))}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ ÚLTIMAS NOTAS ============ -->
  {
    ultimasNotas.length > 0 && (
      <section class="seccion mx-auto max-w-6xl px-5 md:px-8">
        <div class="reveal cabecera-bloque">
          <div>
            <p class="eyebrow">Notas</p>
            <h2 class="mt-3 font-display text-3xl leading-[1.08] tracking-tight sm:text-4xl md:text-[2.7rem]">
              Lo último que escribí
            </h2>
          </div>
          <div class="remate-bloque">
            <p class="nota-bloque">Decisiones de diseño y errores que costaron caro, sin relleno.</p>
            <a href="/notas" class="btn btn-ghost text-sm">
              Todas las notas
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
              </svg>
            </a>
          </div>
        </div>

        <ol class="rejilla-notas">
          {ultimasNotas.map((nota, i) => (
            <li>
              <a
                href={`/notas/${nota.id}/`}
                class="reveal tarjeta-nota card card-hover group"
                data-delay={`${i * 80}ms`}
              >
                <span class="orden-nota" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

                <span class="meta-nota">
                  <time datetime={nota.data.fecha.toISOString()}>{formatearFecha(nota.data.fecha)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{nota.data.minutos ?? minutosDeLectura(nota.body ?? '')} min</span>
                </span>

                <h3 class="titulo-nota">{nota.data.titulo}</h3>
                <p class="resumen-nota">{nota.data.resumen}</p>

                <span class="temas-nota">
                  {nota.data.etiquetas.map((tema) => (
                    <span class="tema-claro">{tema}</span>
                  ))}
                </span>

                <span class="pie-nota">
                  Leer
                  <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- ============ GIREK STUDY ============ -->
  <section class="seccion mx-auto max-w-6xl px-5 md:px-8">
    <div class="band-navy reveal panel-estudio">
      <div class="grid-navy"></div>
      <div class="brillo-estudio" aria-hidden="true"></div>

      <div class="cuerpo-estudio">
        <div class="min-w-0">
          <p class="rotulo-banda">Proyecto de enseñanza</p>
          <h2 class="titulo-estudio">{girekStudy.titulo}</h2>
          <p class="texto-estudio">{girekStudy.descripcion}</p>

          <a href="/girek-study" class="btn btn-primary mt-8">
            Explorar cursos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        {/* Lo que antes solo decía el párrafo, ahora también se ve: tres piezas
            con su estado. El zorro se queda de fondo y deja de competir con el
            texto por el mismo rincón. */}
        <ul class="piezas-estudio">
          {
            [
              {
                titulo: 'Frameworks abiertos',
                detalle: 'Playwright, Screenplay y TypeScript, listos para clonar.',
                estado: 'Disponible',
                listo: true,
                trazo: 'm8.4 8.2-4.6 3.8 4.6 3.8 M15.6 8.2l4.6 3.8-4.6 3.8 M13.6 4.6l-3.2 14.8',
              },
              {
                titulo: 'Las decisiones, explicadas',
                detalle: 'Por qué cada pieza está donde está, y qué pasa si no.',
                estado: 'Disponible',
                listo: true,
                trazo:
                  'M14 3.5H7.5A2 2 0 0 0 5.5 5.5v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8.2z M14 3.5v4.7h4.5 M8.6 12.6h6.8 M8.6 16h4.6',
              },
              {
                titulo: 'Rutas guiadas',
                detalle: 'De los fundamentos a una suite que aguanta en producción.',
                estado: 'En preparación',
                listo: false,
                trazo:
                  'm12 3.4 9.2 4.4-9.2 4.4-9.2-4.4 9.2-4.4Z M5.6 10.1v5c0 1.7 2.9 3 6.4 3s6.4-1.3 6.4-3v-5 M21.2 7.8v6',
              },
            ].map((pieza) => (
              <li class="pieza-estudio">
                <span class="icono-estudio" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d={pieza.trazo} />
                  </svg>
                </span>
                <span class="min-w-0">
                  <span class="titulo-pieza">{pieza.titulo}</span>
                  <span class="detalle-pieza">{pieza.detalle}</span>
                  <span class:list={['estado-pieza', !pieza.listo && 'es-pendiente']}>{pieza.estado}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="float zorro-estudio" aria-hidden="true">
        <img src="/brand/girek-fox-full.png" alt="" width="220" height="173" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============ CTA CONTACTO ============ -->
  <section class="seccion cierre-inicio mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal text-center">
      {/* El punto verde no es adorno: dice que hoy se puede escribir y que la
          respuesta llega. Un formulario mudo es lo que hace dudar. */}
      <p class="senal-disponible">
        <span class="latido" aria-hidden="true"></span>
        Abierto a propuestas · Remoto
      </p>

      <h2 class="mx-auto mt-5 max-w-2xl font-display text-3xl leading-[1.08] tracking-tight sm:text-5xl">
        Hablemos de tu próximo <span class="text-gradient">proyecto de calidad</span>.
      </h2>
