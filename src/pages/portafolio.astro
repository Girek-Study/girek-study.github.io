---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../data/site';
import { proyectos } from '../data/projects';
import { obtenerRepos, haceCuanto } from '../data/github';

const categorias = ['Todos', ...Array.from(new Set(proyectos.map((p) => p.categoria)))];

// Se resuelve en el build: el visitante recibe HTML, no una llamada a GitHub.
const repos = await obtenerRepos();
---

<Layout title={`Portafolio — ${profile.nombre}`} description="Portafolio de proyectos de automatización, QA, web y enseñanza de Giancarlo (Girek) Palomino.">
  <section class="relative overflow-hidden mx-auto max-w-6xl px-5 pt-32 pb-10 md:px-8 md:pt-40">
    <div class="blob -z-10 right-[-3rem] top-12 h-72 w-72" style="background: var(--color-coral)"></div>
    <SectionHeading
      eyebrow="Portafolio"
      title="Proyectos & casos de trabajo"
      subtitle="Automatización, calidad de software, producto y enseñanza. Filtra por categoría."
    />

    <!-- Filtros -->
    <div class="reveal mt-8 flex flex-wrap gap-2" data-delay="80ms">
      {
        categorias.map((c, i) => (
          <button
            class:list={[
              'filtro rounded-full border px-4 py-2 font-mono text-xs transition-all',
              i === 0
                ? 'border-transparent bg-[var(--color-fox)] text-white shadow-[var(--shadow-warm)]'
                : 'border-[var(--color-line-strong)] bg-[var(--color-surface)] text-[var(--color-ink-soft)] hover:border-[var(--color-fox)] hover:text-[var(--color-fox-deep)]',
            ]}
            data-cat={c}
          >
            {c}
          </button>
        ))
      }
    </div>
  </section>

  <!-- Repositorios abiertos: la lista sale de la API de GitHub en cada build -->
  <section class="mx-auto max-w-6xl px-5 pb-4 md:px-8">
    <SectionHeading
      eyebrow="Código abierto"
      title="Repositorios"
      subtitle="Todo lo que publico en GitHub, con el código a la vista. Esta lista se actualiza sola."
    />

    {
      repos.length > 0 ? (
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {repos.map((r, i) => (
            <a
              href={r.url}
              target="_blank"
              rel="noopener"
              class="reveal card card-hover group flex flex-col p-6"
              data-delay={`${(i % 3) * 80}ms`}
            >
              <div class="flex items-center justify-between gap-3">
                <span class="chip">{r.lenguaje ?? 'Repositorio'}</span>
                {r.estrellas > 0 && (
                  <span class="font-mono text-[0.7rem] text-[var(--color-faint)]">★ {r.estrellas}</span>
                )}
              </div>

              <h3 class="mt-5 font-display text-xl tracking-tight group-hover:text-[var(--color-fox-deep)]">
                {r.nombre}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-ink-soft)]">{r.descripcion}</p>

              <div class="mt-5 flex flex-wrap gap-1.5">
                {r.temas.slice(0, 4).map((t) => (
                  <span class="font-mono text-[0.7rem] text-[var(--color-faint)]">#{t}</span>
                ))}
              </div>

              <div class="mt-5 flex items-center justify-between border-t border-[var(--color-line)] pt-4">
                <span class="font-mono text-[0.7rem] text-[var(--color-faint)]">
                  actualizado {haceCuanto(r.actualizado)}
                </span>
                <span class="text-sm font-semibold text-[var(--color-fox-deep)]">Ver código →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-8 font-mono text-sm text-[var(--color-faint)]">
          No se pudo consultar GitHub en este momento.{' '}
          <a href={profile.links.github} target="_blank" rel="noopener" class="link-underline">
            Ver la cuenta directamente →
          </a>
        </p>
      )
    }
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 md:px-8">
    <SectionHeading
      eyebrow="Experiencia"
      title="Casos de trabajo"
      subtitle="Proyectos de cliente, descritos sin datos ni material confidencial."
    />
    <div id="grid-proyectos" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        proyectos.map((p, i) => (
          <article
            class="proyecto reveal card card-hover group flex flex-col p-6"
            data-cat={p.categoria}
            data-delay={`${(i % 3) * 80}ms`}
          >
            <div class="flex items-center justify-between">
              <span class="chip">{p.categoria}</span>
              {p.destacado && (
                <span class="rounded-full bg-[var(--color-fox-tint)] px-2 py-0.5 font-mono text-[0.65rem] text-[var(--color-fox-deep)]">★ destacado</span>
              )}
            </div>
            <h3 class="mt-5 font-display text-xl tracking-tight">{p.titulo}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-ink-soft)]">{p.resumen}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <span class="font-mono text-[0.7rem] text-[var(--color-faint)]">#{t}</span>
              ))}
            </div>
            {(p.repo || p.demo) && (
              <div class="mt-5 flex gap-4 border-t border-[var(--color-line)] pt-4">
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener" class="link-underline text-sm font-semibold text-[var(--color-fox-deep)]">
                    Código →
                  </a>
                )}
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener" class="link-underline text-sm font-semibold text-[var(--color-ink)]">
                    Demo →
                  </a>
                )}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <div id="vacio" class="hidden flex-col items-center gap-3 py-16 text-center">
      <img src="/brand/girek-fox-head.png" alt="Girek" width="64" height="64" class="h-16 w-16 object-contain opacity-80" />
      <p class="font-mono text-sm text-[var(--color-faint)]">No hay proyectos en esta categoría todavía.</p>
    </div>
  </section>

  <script>
    const botones = document.querySelectorAll<HTMLButtonElement>('.filtro');
    const items = document.querySelectorAll<HTMLElement>('.proyecto');
    const vacio = document.getElementById('vacio');

    const activo = ['border-transparent', 'bg-[var(--color-fox)]', 'text-white', 'shadow-[var(--shadow-warm)]'];
    const inactivo = ['border-[var(--color-line-strong)]', 'bg-[var(--color-surface)]', 'text-[var(--color-ink-soft)]'];

    botones.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        botones.forEach((b) => {
          activo.forEach((c) => b.classList.remove(c));
          inactivo.forEach((c) => b.classList.add(c));
        });
        inactivo.forEach((c) => btn.classList.remove(c));
        activo.forEach((c) => btn.classList.add(c));

        let visibles = 0;
        items.forEach((it) => {
          const show = cat === 'Todos' || it.dataset.cat === cat;
          it.style.display = show ? '' : 'none';
          if (show) visibles++;
        });
        vacio?.classList.toggle('hidden', visibles > 0);
        vacio?.classList.toggle('flex', visibles === 0);
      });
    });
  </script>
</Layout>
