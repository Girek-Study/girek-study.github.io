---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatearFecha, minutosDeLectura } from '../../utils/fechas';
import { profile } from '../../data/site';

// Los borradores se ven en `npm run dev` pero nunca se publican.
const publicadas = (
  await getCollection('notas', ({ data }) => import.meta.env.DEV || !data.borrador)
).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// Los minutos se calculan una sola vez aquí: la tarjeta y la ficha de arriba
// tienen que decir lo mismo, y el cuerpo de la nota no se vuelve a recorrer.
const notas = publicadas.map((nota) => ({
  id: nota.id,
  ...nota.data,
  minutos: nota.data.minutos ?? minutosDeLectura(nota.body ?? ''),
  // Los encabezados del cuerpo sirven de índice: dicen qué se trata dentro
  // antes de abrirla, que es lo que decide si vale el clic.
  secciones: [...(nota.body ?? '').matchAll(/^##\s+(.+)$/gm)].map((m) => m[1].trim()),
}));

/** El icono de cada nota sale del mismo campo que elige su portada: un dato
 * menos que mantener y ninguna forma de que los dos se contradigan. */
const ICONOS: Record<string, string> = {
  contrato:
    'M7.5 3.5h9a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2Z M9 8.5h6 M9 12h6 M9 15.5h3.5',
  capas: 'm12 3.4 8.6 4.1-8.6 4.1-8.6-4.1 8.6-4.1Z M3.4 12l8.6 4.1 8.6-4.1 M3.4 16.2l8.6 4.1 8.6-4.1',
  pipeline:
    'M5.5 7.5h3.2 M15.3 7.5h3.2 M5.5 16.5h3.2 M15.3 16.5h3.2 M12 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z M12 19a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z M12 10v4',
  criterio: 'M3.5 6.5h17 M6.5 12h11 M10 17.5h4',
  // Reloj: la espera que se quedó puesta.
  espera: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Z M12 7.6V12l3.1 1.9',
  // Árbol de accesibilidad: lo que el modelo lee en vez de la captura.
  mcp: 'M6 4.5v15 M6 8h5 M6 15.5h5 M13.5 5.5h5v5h-5z M13.5 13h5v5h-5z',
  // Cilindro: el registro que dos pruebas se disputan.
  datos: 'M12 3.5c3.6 0 6.5 1.1 6.5 2.5S15.6 8.5 12 8.5 5.5 7.4 5.5 6 8.4 3.5 12 3.5Z M5.5 6v12c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5V6 M5.5 12c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5',
  // Velocímetro: el percentil que nadie mira.
  carga: 'M3.6 17.5a8.4 8.4 0 1 1 16.8 0 M12 13.6l4.2-3.7',
  // Aviso: el rojo que dejó de avisar.
  rojo: 'M12 4.4 21 19.6H3L12 4.4Z M12 10v4.1 M12 16.9v.2',
  // Barras: lo que se mide y lo que se cree medir.
  metricas: 'M4 19.5h16 M7.5 19.5v-4.6 M12 19.5v-8.4 M16.5 19.5v-11.6',
  // Escalones: las capas que se suben en orden.
  ruta: 'M3.5 19.5h4v-4h4v-4h4v-4h4',
  // De un lado al otro: el riesgo en palabras y su assert.
  traducir: 'M4 8h7 M4 12h5 M4 16h7 M14.5 12h5.5 M17.5 9.2 20.3 12l-2.8 2.8',
  // La figura universal de accesibilidad.
  acceso: 'M12 5.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z M4.5 8.2c2.4.9 4.9 1.4 7.5 1.4s5.1-.5 7.5-1.4 M12 9.6v5.2 M12 14.8 9 21.4 M12 14.8 15 21.4',
  // Marca de revisión sobre una lista.
  revision: 'M4 6.5h9 M4 11h9 M4 15.5h6 M14.5 16.2l2.2 2.3 4.3-5',
  // Medidor: lo que siente quien mira la pantalla.
  vitals: 'M3.5 17.6a8.5 8.5 0 1 1 17 0 M12 17.6V12 M12 12l3.4-3.1',
};

/** Un tema se filtra por su llave, no por su rótulo: "API Testing" → "api-testing". */
const llave = (tema: string) => tema.toLowerCase().replace(/\s+/g, '-');

const conteo = new Map<string, number>();
for (const nota of notas) {
  for (const tema of nota.etiquetas) conteo.set(tema, (conteo.get(tema) ?? 0) + 1);
}
// Primero los temas sobre los que más he escrito; a igualdad, alfabético.
const temas = [...conteo.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const minutosTotales = notas.reduce((suma, nota) => suma + nota.minutos, 0);

// La más reciente va destacada; el resto, en rejilla.
const [destacada, ...resto] = notas;
---

<Layout
  title="Notas — Girek Study"
  description="Apuntes sobre automatización de pruebas, calidad de software y las decisiones de diseño que sostienen una suite a lo largo del tiempo."
>
  <section class="seccion relative overflow-hidden">
    <div class="blob -z-10 right-[-4rem] top-10 h-80 w-80" style="background: var(--color-amber)"></div>
    <div class="blob -z-10 left-[-6rem] top-40 h-64 w-64" style="background: var(--color-cyan-tint); animation-delay: -6s"></div>

    <div class="mx-auto max-w-[82rem] px-5 md:px-8">
      {/* La primera pantalla enseña lo último publicado, no una ficha de
          recuentos: lo que se ve al llegar es una nota que se puede abrir. Las
          cifras bajan a una línea bajo la bajada, que es todo el sitio que
          necesitan. */}
      <div class="reparto-notas">
        <div class="lado-notas">
          <p class="reveal eyebrow">Notas</p>
          <h1 class="reveal titulo-notas" data-delay="60ms">Lo que aprendo escribiendo pruebas</h1>
          <p class="reveal bajada-notas" data-delay="110ms">
            Decisiones de diseño, errores que costaron caro y cosas que ojalá me hubieran contado
            antes. Escritas desde el proyecto en el que ocurrieron, sin relleno.
          </p>

          <dl class="reveal tira-cifras" data-delay="160ms">
            <div>
              <dd>{notas.length}</dd>
              <dt>{notas.length === 1 ? 'nota' : 'notas'}</dt>
            </div>
            <div>
              <dd>{temas.length}</dd>
              <dt>temas</dt>
            </div>
            <div>
              <dd>{minutosTotales}<span class="unidad-notas">min</span></dd>
              <dt>de lectura</dt>
            </div>
          </dl>

          <a href="/rss.xml" class="reveal enlace-rss" data-delay="210ms">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="6.18" cy="17.82" r="2.18"></circle>
              <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"></path>
            </svg>
            Suscribirse por RSS · sin registro ni muro de pago
          </a>
        </div>

        <div class="lado-destacada">
          <a
            href={`/notas/${destacada.id}/`}
            class="reveal nota-destacada group"
            data-delay="80ms"
            data-temas={destacada.etiquetas.map(llave).join('|')}
          >
            <span class="trama-cierre pointer-events-none absolute inset-0" aria-hidden="true" />
            <span class="brillo-cierre pointer-events-none absolute -right-28 -top-36 h-96 w-96 rounded-full" aria-hidden="true" />

            <span class="cuerpo-destacada">
              <span class="block">
                <span class="meta-destacada">
                  <span class="sello-destacada">Lo último</span>
                  <time datetime={destacada.fecha.toISOString()}>{formatearFecha(destacada.fecha)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{destacada.minutos} min de lectura</span>
                </span>

                <h2 class="mt-5 font-display text-[1.9rem] leading-[1.12] tracking-tight md:text-[2.6rem]">
                  {destacada.titulo}
                </h2>
                <p class="mt-4 leading-relaxed text-white/80">{destacada.resumen}</p>

                <span class="mt-6 flex flex-wrap items-center gap-2">
                  {destacada.etiquetas.map((tema) => (
                    <span class="tema-oscuro">{tema}</span>
                  ))}
                </span>

                <span class="mt-7 inline-flex items-center gap-2 font-semibold">
                  Leer la nota
                  <svg
                    class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
                  </svg>
                </span>
              </span>

              {destacada.secciones.length > 0 && (
                <span class="indice-destacada">
                  <span class="rotulo-indice">Lo que hay dentro</span>
                  <ol class="mt-3.5 space-y-2.5">
                    {destacada.secciones.map((seccion, n) => (
                      <li class="renglon-indice">
                        <span class="numero-indice">{String(n + 1).padStart(2, '0')}</span>
                        <span>{seccion}</span>
                      </li>
                    ))}
                  </ol>
                </span>
              )}
            </span>
          </a>
        </div>
      </div>

      {/* Los temas cierran la primera pantalla: antes de bajar ya se sabe de
          qué va todo esto y se puede acotar sin recorrer el archivo. */}
      <nav class="reveal barra-temas barra-cabecera" aria-label="Filtrar por tema" data-delay="200ms">
        <button type="button" class="chip chip-tema is-activo" data-tema="" aria-pressed="true">
          Todas <span class="cuenta-tema">{notas.length}</span>
        </button>
        {temas.map(([tema, veces]) => (
          <button type="button" class="chip chip-tema" data-tema={llave(tema)} aria-pressed="false">
            {tema} <span class="cuenta-tema">{veces}</span>
          </button>
        ))}
      </nav>
    </div>
  </section>

  <section class="seccion mx-auto max-w-[82rem] px-5 md:px-8">
    <div class="reveal cabecera-archivo">
      <div>
        <p class="eyebrow">El archivo</p>
        <h2 class="mt-3 font-display text-3xl leading-[1.08] tracking-tight sm:text-4xl md:text-[2.7rem]">
          Todo lo demás
        </h2>
      </div>

      <div class="control-archivo">
        {/* El espacio tras la cifra es explícito: en JSX el salto de línea
            entre expresiones no deja ninguno. */}
        <p class="nota-bloque">
          <span class="cifra-archivo">{resto.length}</span>{' '}
          {resto.length === 1 ? 'nota más' : 'notas más'}. Los temas también filtran aquí.
        </p>

        {/* Los mandos solo aparecen si hay a dónde ir: con tres notas en una
            pantalla ancha no hay nada que pasar. */}
        <div class="mandos-carrusel" id="mandos-notas" hidden>
          <button type="button" class="mando" data-ir="-1" aria-label="Notas anteriores">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 5.5 8.5 12 15 18.5" />
            </svg>
          </button>
          <button type="button" class="mando" data-ir="1" aria-label="Notas siguientes">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 5.5 6.5 6.5L9 18.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    {
      notas.length === 0 ? (
        <p class="font-mono text-sm text-[var(--color-faint)]">Todavía no hay notas publicadas.</p>
      ) : (
        <>


          {resto.length > 0 && (
            /* Carrusel y no rejilla: el archivo crece con cada nota y en dos
               columnas empujaba el pie una pantalla más abajo cada vez. En
               horizontal ocupa siempre lo mismo. */
            <div class="carrusel-notas">
              <ol class="pista-notas" id="pista-notas">
                {resto.map((nota, i) => (
                  <li data-temas={nota.etiquetas.map(llave).join('|')}>
                    <a
                      href={`/notas/${nota.id}/`}
                      class="reveal tarjeta-nota card card-hover group"
                      data-delay={`${(i % 3) * 70}ms`}
                    >
                      {/* El número no es decoración: dice cuántas van y en qué
                          orden se escribieron. */}
                      <span class="orden-nota" aria-hidden="true">
                        {String(i + 2).padStart(2, '0')}
                      </span>

                      {nota.portada && ICONOS[nota.portada] && (
                        <span class="icono-nota" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d={ICONOS[nota.portada]} />
                          </svg>
                        </span>
                      )}

                      <span class="meta-nota">
                        <time datetime={nota.fecha.toISOString()}>{formatearFecha(nota.fecha)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{nota.minutos} min</span>
                        {nota.borrador && <span class="sello-borrador">borrador</span>}
                      </span>

                      <h3 class="titulo-nota">{nota.titulo}</h3>
                      <p class="resumen-nota">{nota.resumen}</p>

                      <span class="temas-nota">
                        {nota.etiquetas.map((tema) => (
                          <span class="tema-claro">{tema}</span>
                        ))}
                      </span>

                      <span class="pie-nota">
                        Leer
                        <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>

              {/* Cuánto queda por ver. Se esconde igual que los mandos cuando
                  todas las tarjetas caben a la vez. */}
              <div class="riel-notas" id="riel-notas" hidden aria-hidden="true">
                <span class="avance-notas" id="avance-notas"></span>
              </div>
            </div>
          )}
        </>
      )
    }
  </section>

  {/* El pie necesitaba su parada: el archivo acababa pegado a él y el salto
      dejaba las dos cosas partidas por la mitad. */}
  <section class="seccion cierre-inicio sector-cierre mx-auto max-w-[82rem] px-5 md:px-8">
    <div class="bloque-cierre reveal relative overflow-hidden rounded-[28px] text-white">
      <div class="trama-cierre pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="brillo-cierre pointer-events-none absolute -right-32 -top-40 h-96 w-96 rounded-full" aria-hidden="true"></div>

      <div class="relative">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-white/65">¿Hablamos?</p>
        <h2 class="mt-3.5 max-w-3xl font-display text-3xl leading-[1.08] tracking-tight md:text-[2.7rem]">
          Si algo de esto te suena, cuéntamelo
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-white/80">
          Cada una de estas notas salió de un proyecto real. Si estás en uno parecido, escríbeme y
          te cuento qué haría yo, aunque no acabemos trabajando juntos.
        </p>

        <div class="mt-9 grid gap-3 md:grid-cols-3">
          <a href={`mailto:${profile.email}`} class="tarjeta-cierre group">
            <span class="icono-cierre" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.8" y="4.8" width="18.4" height="14.4" rx="2.4" />
                <path d="m3.4 6.4 8.6 6 8.6-6" />
              </svg>
            </span>
            <span class="mt-4 flex items-center gap-2 font-display text-[1.15rem] leading-tight tracking-tight">
              Escríbeme
              <svg class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
              </svg>
            </span>
            <span class="mt-1.5 block break-words text-[0.85rem] leading-relaxed text-white/70">{profile.email}</span>
          </a>

          <a href="/portafolio" class="tarjeta-cierre group">
            <span class="icono-cierre" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m8.4 8.2-4.6 3.8 4.6 3.8 M15.6 8.2l4.6 3.8-4.6 3.8 M13.6 4.6l-3.2 14.8" />
              </svg>
            </span>
            <span class="mt-4 flex items-center gap-2 font-display text-[1.15rem] leading-tight tracking-tight">
              El código
              <svg class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
              </svg>
            </span>
            <span class="mt-1.5 block text-[0.85rem] leading-relaxed text-white/70">Los repositorios abiertos, listos para clonar.</span>
          </a>

          <a href="/rss.xml" class="tarjeta-cierre group">
            <span class="icono-cierre" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <circle cx="6.18" cy="17.82" r="2.18" />
                <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
              </svg>
            </span>
            <span class="mt-4 flex items-center gap-2 font-display text-[1.15rem] leading-tight tracking-tight">
              Por RSS
              <svg class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
              </svg>
            </span>
            <span class="mt-1.5 block text-[0.85rem] leading-relaxed text-white/70">El canal avisa cuando sale una nueva.</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { activarSaltoPorSectores } from '../../scripts/salto-por-sectores';

  /* Dos paradas: la cabecera y el archivo. El archivo es más alto que la
   * ventana, así que se recorre por dentro antes de llegar al pie. */
  const salto = activarSaltoPorSectores({
    paradas: () => [...document.querySelectorAll('.seccion')],
  });

  /* Carrusel del archivo. El desplazamiento lo lleva el navegador con
   * `scroll-snap` horizontal —ahí sí funciona: la caja mide exactamente lo que
   * mide, al revés que en vertical, donde un sector más alto que la ventana no
   * se puede anclar—. El guion solo pone los mandos y decide si hacen falta. */
  const pista = document.getElementById('pista-notas');
  const mandos = document.getElementById('mandos-notas');
  const riel = document.getElementById('riel-notas');
  const avance = document.getElementById('avance-notas');

  if (pista && mandos) {
    const hayDeSobra = () => pista.scrollWidth > pista.clientWidth + 4;

    const revisarMandos = () => {
      const sobra = hayDeSobra();
      mandos.hidden = !sobra;
      if (riel) riel.hidden = !sobra;
      /* El desvanecido del borde derecho insinúa que hay más. Si todas las
       * tarjetas caben, sobra: borraría la última sin motivo. */
      pista.classList.toggle('hay-mas', sobra);

      mandos.querySelectorAll<HTMLButtonElement>('.mando').forEach((boton) => {
        const hacia = Number(boton.dataset.ir ?? '1');
        const tope = pista.scrollWidth - pista.clientWidth;
        boton.disabled =
          hacia < 0 ? pista.scrollLeft <= 4 : pista.scrollLeft >= tope - 4;
      });

      /* El guion de la barra ocupa la parte visible de la pista y se mueve con
       * ella: dice a la vez cuánto se ve y por dónde vas. La barra del navegador
       * hacía lo mismo, pero gris y con el grosor que decidiera el sistema. */
      if (avance && sobra) {
        const visible = pista.clientWidth / pista.scrollWidth;
        const recorrido = pista.scrollLeft / (pista.scrollWidth - pista.clientWidth);
        avance.style.width = `${visible * 100}%`;
        avance.style.transform = `translateX(${(recorrido * (1 - visible) * 100) / visible}%)`;
      }
    };

    mandos.querySelectorAll<HTMLButtonElement>('.mando').forEach((boton) => {
      boton.addEventListener('click', () => {
        // Una tarjeta por golpe: pasar de dos en dos se salta contenido.
        const tarjeta = pista.querySelector('li');
        const paso = tarjeta ? tarjeta.getBoundingClientRect().width + 18 : pista.clientWidth * 0.8;
        pista.scrollBy({ left: paso * Number(boton.dataset.ir ?? '1'), behavior: 'smooth' });
      });
    });

    pista.addEventListener('scroll', revisarMandos, { passive: true });
    window.addEventListener('resize', revisarMandos);
    revisarMandos();
  }

  /* Filtro por tema. Cada ficha declara sus temas en `data-temas`, así que
   * filtrar es esconder lo que no lo lleva: no se reordena nada ni se vuelve a
   * pintar la lista. */
  const botones = document.querySelectorAll<HTMLButtonElement>('.chip-tema');
  const fichas = document.querySelectorAll<HTMLElement>('[data-temas]');

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      const tema = boton.dataset.tema ?? '';

      botones.forEach((otro) => {
        const activo = otro === boton;
        otro.classList.toggle('is-activo', activo);
        otro.setAttribute('aria-pressed', String(activo));
      });

      fichas.forEach((ficha) => {
        const suyos = (ficha.dataset.temas ?? '').split('|');
        // La ficha destacada es un enlace suelto; la de la rejilla vive dentro
        // de su <li>. Se esconde el elemento que declara los temas y, si está
        // dentro de una lista, también su renglón, para que no quede el hueco.
        const objetivo = ficha.closest('li') ?? ficha;
        (objetivo as HTMLElement).hidden = tema !== '' && !suyos.includes(tema);
      });

      /* El archivo acaba de cambiar de alto sin que la ventana se haya movido:
       * si no se recalculan, las paradas del salto apuntan a donde estaban las
       * tarjetas antes de esconderse. */
      salto.rearmar();

      // Con menos tarjetas puede que ya no haya nada que pasar.
      pista?.dispatchEvent(new Event('scroll'));
      window.dispatchEvent(new Event('resize'));
    });
  });
</script>
