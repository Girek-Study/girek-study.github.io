---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

// Lo que se ve al compartir el enlace en WhatsApp, LinkedIn o Slack. Antes
// heredaba el titular personal y la biografía; ahora dice lo mismo que la
// portada, que es la promesa de la marca.
const {
  title = 'Girek Study — Automatización de pruebas y QA en español',
  description = 'La calidad no se repite: se programa. Frameworks abiertos que puedes clonar, con las decisiones de diseño explicadas. Por Giancarlo Palomino, Quality Engineer con 10 años en banca, fintech y salud.',
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const portada = new URL('/og.png', Astro.site).href;

/**
 * Datos estructurados. Sin esto, para Google el sitio es texto suelto; con
 * esto entiende que "Girek Study" es el nombre de un sitio, que detrás hay una
 * persona concreta y que sus perfiles de LinkedIn y GitHub son la misma
 * entidad. Es lo que separa aparecer por el nombre de marca de no aparecer.
 */
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#sitio`,
      url: Astro.site?.href,
      name: 'Girek Study',
      alternateName: ['Girek Study — automatización de pruebas', 'Girek'],
      description:
        'Automatización de pruebas y QA en español: frameworks abiertos, decisiones de diseño explicadas y, próximamente, clases.',
      inLanguage: 'es',
      publisher: { '@id': `${Astro.site}#persona` },
    },
    {
      '@type': 'Person',
      '@id': `${Astro.site}#persona`,
      name: profile.nombreCompleto,
      alternateName: ['Giancarlo Palomino', 'Girek'],
      url: Astro.site?.href,
      email: `mailto:${profile.email}`,
      jobTitle: 'Quality Engineer · Test Automation Lead',
      description: profile.bio,
      knowsAbout: [
        'Automatización de pruebas',
        'Quality Engineering',
        'Playwright',
        'TypeScript',
        'Patrón Screenplay',
        'Pruebas de APIs',
        'CI/CD',
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
      sameAs: [profile.links.linkedin, profile.links.github],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/girek-fox-180.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" type="application/rss+xml" title="Girek Study — Notas" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Girek Study" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={portada} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={portada} />

    <meta name="theme-color" content="#ff6a1a" />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Clash Display (Fontshare) para títulos expresivos -->
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap"
      rel="stylesheet"
    />

    <!-- Si el JS no carga, mostrar todo el contenido (las animaciones quedan deshabilitadas) -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-[var(--color-accent)] focus:px-4 focus:py-2 focus:text-[var(--color-ink-950)]"
      >Saltar al contenido</a
    >
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Revelado al hacer scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).style.transitionDelay =
                  (e.target as HTMLElement).dataset.delay ?? '0ms';
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
